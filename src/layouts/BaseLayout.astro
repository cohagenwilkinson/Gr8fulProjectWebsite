---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Homepage-only: header overlays the hero transparently instead of its solid bar. */
  transparentHeader?: boolean;
  /** Solid-background pages that want the homepage's flat nav (Home/Podcast/Jams/Seva/About, no Events/Van) and Join CTA instead of the standard site nav. See SiteHeader.astro. */
  homeNav?: boolean;
  /**
   * Per-page override for the social/link-preview image (Open Graph +
   * Twitter Card) — a public/ absolute path, e.g. "/some-other-share.png".
   * No page sets this today, so every page currently gets the site-wide
   * default below; it exists so a future page-specific image can take
   * precedence without touching this layout again.
   */
  ogImage?: string;
}

const {
  title,
  description,
  transparentHeader = false,
  homeNav = false,
  ogImage = '/gr8ful-social-share.png',
} = Astro.props;

// Astro.site is the `site` value from astro.config.mjs (https://www.gr8fulproject.org)
// — building absolute URLs off it rather than hardcoding the domain here.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {/* Open Graph — Facebook, iMessage, Slack, LinkedIn, Discord, etc.
        og:image is the 1200x630 gr8ful-social-share.png by default (a
        cropped/reformatted version of Live_Happier.png, sized to the
        standard OG dimensions — see that file's own notes for how it was
        derived); ogImage lets a future page override it via the prop
        above. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gr8ful Project" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gr8ful Project — Live Happier" />

    {/* Twitter/X — needs its own tags even though they duplicate several
        Open Graph values; Twitter's card renderer doesn't read og:* for
        the title/description/image. summary_large_image is the big-photo
        card format (vs. a small square thumbnail). */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImageURL} />

    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/*
      Inter is the web stand-in for the Keynote's Helvetica Neue (Regular /
      Medium), which the design deck uses for interface chrome — nav links,
      button labels, and small metadata captions. Added here because a font
      can only be *used* if it is actually served; declaring Inter in CSS
      without loading it would silently fall back to a system face. Adding
      the family changes nothing on pages that don't ask for it — today only
      /about does. Instrument Serif and Poppins stay because /privacy still
      renders with them; see the note in CLAUDE.md about reconciling that
      with the Keynote. (/podcast, /van, /jams, /pledge, and /pledge/thanks
      are all retired now — this list used to name them, but none of them
      render anything any more.)
    */}
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Backmost light ground: the only layer carrying paper grain. -->
    <div class="g8-ground">
      <SiteHeader transparent={transparentHeader} homeNav={homeNav} />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
