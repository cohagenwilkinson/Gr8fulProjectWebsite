---
/**
 * Join the Project — pages 5, 6, 7 of the approved redesign. One interactive
 * homepage section, not three routes: the teal sunburst background (page 5)
 * stays mounted the whole time, and a single modal switches between the
 * pledge view (page 6) and the welcome view (page 7) on top of it.
 *
 * PROTOTYPE NOTE — the form here is local-only. It validates and advances
 * state client-side but never submits anywhere; it does not touch
 * /api/pledge, Brevo, or the existing /pledge and /pledge/thanks routes,
 * which keep working exactly as before. Field set intentionally differs
 * from PledgeForm.astro (First Name/Email/Zipcode vs. the production
 * contract), so this is deliberately a separate component rather than a
 * reuse of that one.
 *
 * Media: the video-preview stills are cropped straight from pages 5 and 7
 * of the PDF — temporary, not final assets (see the "prototype" filenames).
 * The welcome card's signature is the real supplied asset
 * (join-robbiedob-sig-large.png), not baked into the crop, so the crop for
 * that card stops above the caption/signature line on purpose.
 */
---

<section class="join g8-section-panel" id="join">
  <img
    src="/join-wallpaper-burst-deepteal.png"
    alt=""
    aria-hidden="true"
    class="join__bg"
  />

  <div class="g8-container join__body">
    <h2 class="join__headline">Join the Project</h2>
    <p class="join__subhead">Take the pledge. Get invites. Stay in touch.</p>

    <div class="join__media">
      {/* Real asset — replaces the page-5 PDF-crop placeholder. Source is
          portrait (720×1280); the square container/object-fit:cover crop
          is unchanged from the placeholder, so this just drops into the
          existing frame. Not autoplayed (it has audio) and not looped —
          native controls, user presses play.

          Poster: there's no separate custom Play-button overlay here (this
          is a plain native <video controls>, not a custom-built player), so
          the native `poster` attribute is the exactly-right tool rather
          than a second image layer — it's the SAME element, styled by the
          SAME .join__media-img rule (object-fit/object-position/dimensions)
          that applies to the video once playing, so the poster crop can't
          drift from the video crop, and there's nothing to hide/swap in JS
          when playback starts. The poster is the same 720×1280 footage
          (join-the-project-poster.jpg), so the framing lines up exactly. */}
      <video
        src="/join-the-project.mp4"
        poster="/join-the-project-poster.jpg"
        controls
        playsinline
        preload="metadata"
        class="join__media-img"
      >
      </video>
    </div>

    <button type="button" class="g8-btn g8-btn--gold g8-btn--cta g8-btn--cta-shadow join__cta" data-join-open>
      Take the pledge
    </button>
  </div>

  <div class="join-modal" data-join-modal hidden>
    <div class="join-modal__backdrop" data-join-close aria-hidden="true"></div>

    <div class="join-modal__panel" role="dialog" aria-modal="true" aria-label="Join the Gr8ful Project">
      <div class="join-modal__view" data-join-view="pledge">
        <button type="button" class="join-modal__close" data-join-close aria-label="Close">✕</button>
        <h3 class="join-modal__heading">The Gr8ful Pledge</h3>

        <!-- Flat, row-major children (not two independently-flowing column
             divs) so the grid's own 2-col × 5-row auto-placement is what
             lines up "I promise:"/Subscribe, each pledge paragraph with its
             corresponding field label, and the two checkboxes — see
             .join-modal__grid below. Each pair (heading/heading, promise/
             field, ...) is two consecutive children, filling left-then-
             right, row by row, in source order. -->
        <form class="join-modal__grid" data-join-form novalidate>
          <h4 class="join-modal__col-heading">I promise:</h4>
          <h4 class="join-modal__col-heading">Subscribe</h4>

          <p class="join-modal__promise">
            To practice when I can.<br />
            Be kind to myself when I can't.<br />
            Return when I'm able - without guilt.
          </p>
          <label class="join-modal__field">
            <span class="join-modal__label">First name</span>
            <input type="text" name="firstName" autocomplete="given-name" required />
          </label>

          <p class="join-modal__promise">
            This is my project.<br />
            This is my promise.
          </p>
          <label class="join-modal__field">
            <span class="join-modal__label">Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <p class="join-modal__promise join-modal__promise--em">
            I don't need perfect attendance to make progress.<br />
            I believe tomorrow can be better than today.
          </p>
          <label class="join-modal__field">
            <span class="join-modal__label">Zipcode</span>
            <input type="text" name="zip" autocomplete="postal-code" inputmode="numeric" required />
          </label>

          <label class="join-modal__checkbox">
            <input type="checkbox" name="promise" required />
            <span>I hereby promise</span>
          </label>
          <label class="join-modal__checkbox">
            <input type="checkbox" name="invites" />
            <span>Get invites and stay in touch</span>
          </label>

          <button type="submit" class="g8-btn g8-btn--gold g8-btn--cta g8-btn--cta-shadow join-modal__submit">Make it official</button>
          <p class="join-modal__error" data-join-error hidden role="alert"></p>
        </form>
      </div>

      <div class="join-modal__view" data-join-view="welcome" hidden>
        <button
          type="button"
          class="join-modal__close join-modal__close--welcome"
          data-join-close
          aria-label="Close"
        >
          ✕
        </button>
        <h3 class="join-modal__heading">Welcome to The Gr8ful Project</h3>

        <div class="join-modal__welcome-card">
          {/*
            Real asset — replaces the page-7 PDF-crop placeholder. Source is
            portrait (1080×1920); same native poster+controls pattern as
            .join__media-img above (see that comment for why: no separate
            custom Play-button layer exists on the actual site, so the
            native `poster` attribute is the right tool, not a second image
            element). The decorative (aria-hidden, non-interactive) "replay"
            circle that used to sit here was a stand-in for a play button
            over a static photo — now that a REAL native play control
            exists, it's redundant/would double up with it, so it's removed
            rather than left floating on top of working video controls.
          */}
          <video
            src="/thanks-for-joining.mp4"
            poster="/thanks-for-joining-poster.jpg"
            controls
            playsinline
            preload="metadata"
            class="join-modal__welcome-photo"
          >
          </video>
          <div class="join-modal__welcome-wash" aria-hidden="true"></div>
          <div class="join-modal__welcome-copy">
            <p class="join-modal__welcome-text">
              I am Gr8ful for you.<br />
              Even if we haven't met yet.
            </p>
            <img
              src="/join-robbiedob-sig-large.png"
              alt="Robbie Dob"
              class="join-modal__welcome-sig"
            />
          </div>
        </div>

        <button type="button" class="join-modal__return" data-join-close>Return to site</button>
      </div>
    </div>
  </div>
</section>

<script>
  const joinSection = document.querySelector<HTMLElement>('.join');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-join-open]');
  const modal = document.querySelector<HTMLDivElement>('[data-join-modal]');
  const closeEls = document.querySelectorAll<HTMLElement>('[data-join-close]');
  const form = document.querySelector<HTMLFormElement>('[data-join-form]');
  const pledgeView = document.querySelector<HTMLElement>('[data-join-view="pledge"]');
  const welcomeView = document.querySelector<HTMLElement>('[data-join-view="welcome"]');
  const submitBtn = form?.querySelector<HTMLButtonElement>('.join-modal__submit');
  const errorEl = form?.querySelector<HTMLElement>('[data-join-error]');
  const submitLabel = submitBtn?.textContent ?? 'Make it official';
  let submitting = false;

  // Thank-you overlay ("I am Gr8ful for you...") stays hidden through the
  // poster and playback, and only appears once the video has actually been
  // watched through — `ended` reveals it, `play` hides it again, which also
  // covers pressing the native Replay control (that fires `play`, same as
  // a first play). CSS reacts to the --ended class name; see
  // .join-modal__welcome-card--ended in the styles below.
  const welcomeCard = document.querySelector<HTMLElement>('.join-modal__welcome-card');
  const welcomeVideo = document.querySelector<HTMLVideoElement>('.join-modal__welcome-photo');
  welcomeVideo?.addEventListener('ended', () => {
    welcomeCard?.classList.add('join-modal__welcome-card--ended');
  });
  welcomeVideo?.addEventListener('play', () => {
    welcomeCard?.classList.remove('join-modal__welcome-card--ended');
  });

  function showPledgeView() {
    pledgeView?.removeAttribute('hidden');
    welcomeView?.setAttribute('hidden', '');
  }

  function showWelcomeView() {
    welcomeView?.removeAttribute('hidden');
    pledgeView?.setAttribute('hidden', '');
  }

  function openModal() {
    showPledgeView();
    modal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    // Hides the page-5 "Take the pledge" CTA and blocks pointer interaction
    // with everything else in the base section while a modal is open — the
    // section itself (heading/subhead/media card) stays visible, dimmed by
    // the modal backdrop, so it still reads as the same layered section.
    joinSection?.classList.add('join--modal-open');
  }

  function closeModal() {
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    joinSection?.classList.remove('join--modal-open');
    // Next open always starts at the pledge step, not wherever it was left.
    showPledgeView();
    form?.reset();
    // So a later pledge doesn't reopen the welcome view already showing the
    // overlay from a previous watch-through, in case the video element
    // itself retains its ended state across opens.
    welcomeCard?.classList.remove('join-modal__welcome-card--ended');
    if (errorEl) errorEl.hidden = true;
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = submitLabel;
    }
  }

  openBtn?.addEventListener('click', openModal);

  closeEls.forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      closeModal();
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !modal?.hasAttribute('hidden')) {
      closeModal();
    }
  });

  // Posts to /api/join-pledge, which emails a notification of the
  // submission (see that route for recipients/provider details). The
  // welcome view only opens once the server confirms the send — never on
  // native validation alone, and never twice for one button press (the
  // `submitting` guard blocks a second submit firing while the first
  // request is still in flight, e.g. from a double-click or Enter-then-
  // click).
  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitting) return;
    submitting = true;

    if (errorEl) errorEl.hidden = true;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }

    const data = new FormData(form);

    fetch('/api/join-pledge', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        firstName: data.get('firstName'),
        email: data.get('email'),
        zip: data.get('zip'),
        // Checkbox: FormData omits an unchecked box entirely (data.get
        // returns null), so Boolean(...) is the whole conversion — checked
        // ("on", since the input has no explicit value) -> true, missing -> false.
        invites: Boolean(data.get('invites')),
      }),
    })
      .then(async (response) => {
        const result = await response.json().catch(() => ({}));
        if (response.ok && result?.ok) {
          showWelcomeView();
          return;
        }
        if (errorEl) {
          errorEl.textContent = result?.message ?? 'Something went wrong. Please try again.';
          errorEl.hidden = false;
        }
      })
      .catch(() => {
        // Offline or the request never landed — keep their input, let them retry.
        if (errorEl) {
          errorEl.textContent =
            'We couldn’t reach the server. Please check your connection and try again.';
          errorEl.hidden = false;
        }
      })
      .finally(() => {
        submitting = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel;
        }
      });
  });
</script>

<style>
  .join {
    /* Vertical rhythm below is measured directly off page 5 of the PDF
       (1920×1080 canvas) and expressed in vw — using the canvas WIDTH as
       the reference for vertical gaps too, so the whole composition scales
       together and keeps the PDF's proportions regardless of viewport
       aspect ratio, the same technique used for every horizontal measure
       on this page. Canvas top to headline top measured at 75px = 3.9vw;
       CTA bottom to canvas bottom at 38px = 2.0vw. */
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 3.9vw, 88px) clamp(20px, 2vw, 48px);
  }

  .join__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .join__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .join__headline {
    /* Confirmed directly from the PDF's embedded font resources (not a
       visual approximation): the actual text run "Join the Project" on
       page 5 is set in JostRoman-Bold. Jost is already loaded sitewide
       (var(--g8-font-ui)) at weight 700. */
    margin: 0;
    font-family: var(--g8-font-ui);
    font-weight: 700;
    /* Re-measured against the PDF's own embedded text run: 86.3pt on the
       1920 canvas = 4.49vw. The previous 68px ceiling (4.7vw rate, but
       capped well below what that rate would reach at 1920) undershot it. */
    font-size: clamp(34px, 4.49vw, 86px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--g8-golden-hour);
    /* Hard, zero-blur offset shadow — measured off the PDF, same flat-offset
       language used for every other headline/CTA on this page. */
    text-shadow: 3px 3px 0 var(--g8-midnight);
  }

  .join__subhead {
    /* Also JostRoman-Bold per the PDF's embedded fonts — same face as the
       headline, not the light body-copy treatment used for prose
       elsewhere. Gap to headline measured at 26px/1920 = 1.35vw. */
    margin: clamp(8px, 1.35vw, 20px) 0 0;
    font-family: var(--g8-font-ui);
    font-weight: 700;
    /* Re-measured: 40.7pt on the 1920 canvas = 2.12vw. */
    font-size: clamp(22px, 2.12vw, 41px);
    color: var(--g8-chalk);
    text-shadow: 2px 2px 0 var(--g8-midnight);
  }

  .join__media {
    /* Square in the PDF (683×683 measured on the 1920px canvas, ratio
       exactly 1.0) — sized as a share of viewport width, not the container,
       so the proportion holds at every desktop width instead of tracking
       the container's own max-width. */
    width: clamp(240px, 35.6vw, 520px);
    aspect-ratio: 1 / 1;
    /* Gap above (subhead bottom to card top, 42px/1920) and below (card
       bottom to CTA top, 23px/1920), both measured off the PDF and much
       tighter than a guessed value — this is what pulls the card and CTA
       up together as one block. */
    margin: clamp(20px, 2.19vw, 42px) 0 clamp(10px, 1.2vw, 23px);
    border-radius: var(--g8-radius-lg);
    border: var(--g8-stroke-bold) solid var(--g8-border-strong);
    overflow: hidden;
  }

  .join__media-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Portrait 720×1280 source inside a square frame — this is the ONE
       value to change for "move the video up/down": raising the vertical
       number moves the visible crop window DOWN the source (showing more
       of Rob's lower body/less headroom), lowering it moves the crop
       window UP (more headroom, tighter on the face). 45% (vs. a plain
       centered 50%) was chosen after inspecting the actual clip, which
       reads slightly better with a touch more headroom than dead-center.
       Also governs the poster image (join-the-project-poster.jpg, same
       720×1280 footage) via the `poster` attribute on the same element —
       one rule, so poster and video crop can't drift apart from each
       other; there's no second element/layer for this to apply to. */
    object-position: 50% 45%;
  }

  .join__cta {
    /* Font/case/size/shadow now come from the shared .g8-btn--cta(-shadow)
       classes on the element (Inter Medium, the 9pt/301.3° hard shadow) —
       this rule only owns the bold border this CTA doesn't share with the
       rest of the primary-CTA family. */
    border: var(--g8-stroke-bold) solid var(--g8-border-strong);
  }
  .join__cta:hover { background: var(--g8-golden-dk); }

  /* While a modal is open: hide the CTA outright (not just dim it — the
     backdrop already dims everything, but the CTA sitting right at the
     modal's lower edge kept peeking out below it, reading as a second,
     still-clickable button) and block pointer interaction with the rest of
     the base section. Heading/subhead/media card stay visible, dimmed by
     the modal backdrop, so the section still reads as layered underneath
     rather than swapped out. */
  .join--modal-open .join__cta {
    visibility: hidden;
  }
  .join--modal-open .join__body {
    pointer-events: none;
  }

  /* ── Modal shell ──────────────────────────────────────
     Fixed overlay so it sits on top of the still-mounted section above,
     not a separate page/route. */
  .join-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    padding: clamp(16px, 4vw, 40px);
  }
  /* :not([hidden]) — an author display rule on this class would otherwise
     outrank the UA [hidden] { display:none } rule at equal specificity and
     render the modal open by default. Same fix as .header__menu in
     SiteHeader.astro. */
  .join-modal:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .join-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(1, 7, 21, 0.6);
  }

  .join-modal__panel {
    /* Outer bounds measured directly off page 6 of the PDF: 1368×779 on the
       1920 canvas — 71.25% of canvas width, 72.1% of canvas height, an
       outer ratio of 1.756:1. Setting width AND height independently (one
       as vw, one as vh) only reproduces that ratio at one specific
       viewport aspect ratio; at any other aspect it drifts, which is how
       the previous pass (79.25vw wide, capped at 80vh tall) ended up
       reading as nearly full-screen on shorter/narrower desktop windows.
       min(vw, vh-scaled-by-the-ratio) plus a locked aspect-ratio keeps the
       PDF's shape exact and guarantees the box never exceeds ~71% width
       OR ~72% height, on any desktop viewport. Tablet/mobile override this
       back to flexible sizing below — this exact shape is a desktop-only
       target, same as the rest of the PDF comp. */
    position: relative;
    /* The percentage/vh formula is the target at ordinary desktop sizes,
       matching the PDF — but with no ceiling it grows without limit on very
       large monitors/windows. max-width stops it at the 1440px-wide design's
       own rendered size (71vw × 1440 ≈ 1022px, rounded) — the modal reaches
       that size and then holds, rather than continuing to scale on a 4K or
       ultrawide viewport. */
    width: min(71vw, calc(72vh * 1.7561));
    max-width: 1024px;
    aspect-ratio: 1368 / 779;
    overflow-y: auto;
    background: var(--g8-parchment);
    border: var(--g8-stroke-bold) solid var(--g8-border-strong);
    border-radius: var(--g8-radius-lg);
    /* Keynote's own spec for this shadow (20pt offset @325.1°), not the
       generic --g8-shadow-lift — see tokens.css for the trig. */
    box-shadow: var(--g8-shadow-modal);
    /* Establishes the `cqw` unit used throughout this modal's type/spacing
       below, sized against THIS element's own (now capped) width rather
       than the raw viewport. Without this, every clamp() in here keeps
       scaling off vw past the point where max-width stops the panel itself
       from growing — the panel holds still, but headline/label/checkbox
       text keeps enlarging toward each clamp's own ceiling, so the same
       copy that fit at ~1440px starts wrapping/overflowing on a wider
       window even though the box around it never got any bigger. cqw makes
       text stop growing at exactly the same width the panel does. */
    container-type: inline-size;
  }

  .join-modal__view {
    position: relative;
    /* Tightened further from the previous pass so content fits the
       smaller, PDF-accurate shell above without relying on scroll at
       ordinary desktop sizes — proportional scaling of the same spacing,
       not a redesign. cqw (relative to .join-modal__panel's own, now
       capped, width) rather than vw — see the container-type note there. */
    padding: clamp(10px, 1.97cqw, 26px) clamp(20px, 5.63cqw, 56px) clamp(10px, 2.82cqw, 38px);
  }

  .join-modal__close {
    position: absolute;
    top: clamp(12px, 2.11cqw, 22px);
    right: clamp(12px, 2.11cqw, 22px);
    width: 38px;
    height: 38px;
    display: grid;
    place-content: center;
    border-radius: 999px;
    border: var(--g8-stroke) solid var(--g8-border-strong);
    background: transparent;
    color: var(--g8-midnight);
    font-family: var(--g8-font-ui);
    font-size: 15px;
    cursor: pointer;
  }
  .join-modal__close:hover { background: var(--g8-chalk); }

  /* Welcome state's close mark is black, same as the pledge state — no
     modifier colors left to override; the class stays as a hook in case
     the two states need to diverge again later. */
  .join-modal__close--welcome:hover { background: var(--g8-chalk); }

  .join-modal__heading {
    /* JostRoman-Bold per the PDF's embedded fonts, same as .join__headline.
       55pt on the 1920 canvas = 2.86vw — shared by both modal states
       ("The Gr8ful Pledge" and "Welcome to The Gr8ful Project" measure the
       same size in the deck). */
    margin: 0 0 clamp(10px, 2.68cqw, 24px);
    text-align: center;
    font-family: var(--g8-font-ui);
    font-weight: 700;
    font-size: clamp(24px, 4.03cqw, 55px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--g8-golden-hour);
    text-shadow: 2px 2px 0 var(--g8-midnight);
  }

  /* ── Pledge view ──────────────────────────────────────── */
  /* Shared 2-column × 5-row grid — the actual alignment mechanism. Every
     pair of children (see the markup above) lands in the same row via plain
     grid auto-placement, so "I promise:"/Subscribe, each pledge paragraph/
     field pair, and the two checkboxes all share a row automatically —
     nothing here targets a specific row or element by hand. align-items:
     start keeps every cell's content flush to its row's top edge (so a
     taller left-hand paragraph never pushes the shorter field on the right
     down to vertically center in the row). column-gap is unchanged from
     the max-size/no-wrap pass (still cqw, still what keeps the two columns
     from crowding at the modal's capped width); row-gap is new — see the
     comment on each element below for why their own margins were zeroed in
     favor of this one shared value. */
  .join-modal__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    column-gap: clamp(18px, 5.07cqw, 48px);
    row-gap: clamp(14px, 3.2cqw, 28px);
  }

  .join-modal__col-heading {
    /* JostRoman-Bold 33pt per the PDF ("I promise:" / "Subscribe") = 1.72vw
       on the 1920 canvas — was capped well under that. cqw (relative to
       .join-modal__panel's own width) rather than vw from here down — see
       the container-type note on that rule for why.

       No bottom margin any more — spacing to the next row now comes
       entirely from .join-modal__grid's row-gap, so it stays IDENTICAL on
       both sides of a row instead of each column accumulating its own,
       possibly-different, margin. */
    margin: 0;
    font-family: var(--g8-font-ui);
    font-weight: 700;
    font-size: clamp(16px, 2.42cqw, 33px);
    color: var(--g8-midnight);
  }

  .join-modal__promise {
    /* Jost-Regular 26pt per the PDF (1.354vw on the 1920 canvas), not the
       sitewide Poppins body face — re-measured up from an earlier ~12%
       "read as too small" correction that was still well under the deck's
       actual size.

       No bottom margin — see the row-gap note on .join-modal__col-heading
       above; same reasoning applies to every row in this grid. */
    margin: 0;
    font-family: var(--g8-font-ui);
    font-weight: 400;
    font-size: clamp(14px, 1.91cqw, 26px);
    line-height: 1.32;
    color: var(--g8-midnight);
  }
  .join-modal__promise--em {
    /* Jost-Italic (a real italic face, loaded specifically for this —
       see the Google Fonts link in BaseLayout.astro — not a synthetic
       oblique of the upright weight). */
    font-style: italic;
  }

  .join-modal__field {
    /* No margin-bottom — the grid's row-gap owns row-to-row spacing now,
       and the field's own top edge (this element IS the row's right-hand
       cell) is what the corresponding pledge paragraph aligns to. */
    display: block;
  }

  .join-modal__label {
    /* JostRoman-SemiBold 17pt per the PDF (FIRST NAME / EMAIL / ZIPCODE)
       = 0.885vw on the 1920 canvas. */
    display: block;
    margin-bottom: 4px;
    font-family: var(--g8-font-ui);
    font-weight: var(--g8-weight-ui);
    font-size: clamp(11px, 1.25cqw, 17px);
    letter-spacing: var(--g8-track-caps);
    text-transform: uppercase;
    color: var(--g8-midnight);
  }

  .join-modal__field input {
    /* Inter — interface chrome, not the site's Poppins body face (which
       this pass is removing from the button/form/UI register entirely).
       Vertical padding raised from 6px to 9.5px (6px→31.5px was measured
       as feeling short next to the bold type/CTAs elsewhere) — a ~22%
       taller field (31.5px→38.5px measured), landing in the middle of the
       requested 20-25% range. Horizontal padding, font, border, radius,
       and background are all untouched. */
    width: 100%;
    padding: 9.5px 12px;
    font-family: var(--g8-font-inter);
    /* Flat 16px, not the previous clamp(13px, 1.27cqw, 16px) — iOS Safari
       force-zooms the page on focus into any text input computing under
       16px, and doesn't un-zoom on blur/submit, which is what was leaving
       the thank-you video and the page itself off-center after this form.
       The old clamp's cqw-based preferred value never actually reached its
       own 16px ceiling anywhere within the panel's real width range (mobile
       through the 1024px desktop cap all resolve below it), so it was
       already rendering as a de facto flat 13px, not a genuinely fluid
       size — this isn't a visual regression, it's naming what was already
       happening and moving the floor to the one value mobile Safari
       requires. */
    font-size: 16px;
    color: var(--g8-midnight);
    background: var(--g8-chalk);
    border: var(--g8-stroke) solid var(--g8-border-strong);
    border-radius: var(--g8-radius-sm);
  }
  .join-modal__field input:focus-visible {
    outline: 2px solid var(--g8-focus);
    outline-offset: 2px;
  }

  .join-modal__checkbox {
    /* JostRoman-SemiBold 23pt per the PDF ("I hereby promise" / "Get
       invites and stay in touch") = 1.198vw — a distinct, larger size from
       the 17pt field labels above, not the same scale as previously coded. */
    /* No top margin — this row's spacing above it comes from the grid's
       row-gap, same as every other row. */
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--g8-font-ui);
    font-weight: var(--g8-weight-ui);
    font-size: clamp(14px, 1.69cqw, 23px);
    color: var(--g8-midnight);
    cursor: pointer;
  }

  .join-modal__checkbox input[type='checkbox'] {
    /* Scaled up to match the bigger 23pt label text beside it. */
    appearance: none;
    flex: none;
    width: 18px;
    height: 18px;
    display: inline-grid;
    place-content: center;
    background: var(--g8-chalk);
    border: var(--g8-stroke) solid var(--g8-border-strong);
    border-radius: 4px;
    cursor: pointer;
  }
  .join-modal__checkbox input[type='checkbox']::before {
    content: '';
    width: 10px;
    height: 10px;
    background: var(--g8-midnight);
    transform: scale(0);
    transition: transform var(--g8-dur-fast) var(--g8-ease);
  }
  .join-modal__checkbox input[type='checkbox']:checked::before {
    transform: scale(1);
  }

  .join-modal__submit {
    /* Font/case/shadow come from the shared .g8-btn--cta(-shadow) classes
       on the element now — this rule only owns layout (centered under a
       2-column grid) and the bold border it shares with .join__cta. */
    grid-column: 1 / -1;
    justify-self: center;
    margin-top: clamp(6px, 1.41cqw, 14px);
    border: var(--g8-stroke-bold) solid var(--g8-border-strong);
  }
  .join-modal__submit:hover { background: var(--g8-golden-dk); }
  .join-modal__submit:disabled { cursor: not-allowed; }

  .join-modal__error {
    /* Same role/placement as .pledge__error on the site's other form
       (PledgeForm.astro) — shown only when the server rejects a
       submission or the request never lands, so entered values are never
       lost and the welcome view never opens on a failure. */
    grid-column: 1 / -1;
    justify-self: center;
    margin: 0;
    text-align: center;
    font-family: var(--g8-font-inter);
    font-size: clamp(13px, 1.41cqw, 15px);
    color: var(--g8-crimson);
  }

  /* ── Welcome view ─────────────────────────────────────── */
  .join-modal__welcome-card {
    /* Outer bounds measured directly off page 7 of the PDF: 617×566 on the
       1920 canvas — very close to square but very slightly WIDER than
       tall (ratio 1.09), not portrait as it might read at a glance.
       Sized relative to the modal panel's own width (617/1368 ≈ 45% of
       the panel, which is itself 71.25vw), not the old fixed clamp. */
    /* Min-width raised from an earlier 190px — at narrow phone widths that
       floor made the card too narrow for the caption to wrap to its normal
       two lines, pushing a third line up into the replay icon below. */
    position: relative;
    width: clamp(260px, 45.21cqw, 420px);
    aspect-ratio: 617 / 566;
    margin: 0 auto;
    border-radius: var(--g8-radius-lg);
    border: var(--g8-stroke-bold) solid var(--g8-border-strong);
    /* Measured directly off page 7: border + shadow band together are only
       ~4-7px at the 1920 canvas scale — much tighter than --g8-shadow-lift
       (10px, sized for the much larger modal panel). A flat small offset
       matches what's actually there instead of scaling with viewport. */
    box-shadow: 4px 4px 0 var(--g8-midnight);
    overflow: hidden;
  }

  .join-modal__welcome-photo {
    /* Fills the entire card — no separate photo region + solid panel.
       Source is a much taller portrait (1080×1920, ~9:16) than this
       slightly-wider-than-tall card (617:566), so cover fits by WIDTH —
       roughly half the source's height ends up cropped away, making the
       vertical object-position value below do most of the framing work
       (unlike the square Join card, where cropping was mostly horizontal
       and this number barely mattered). This is the ONE value to change
       for "move it up/down": inspected against the actual footage, 42%
       keeps Rob's face/peace-sign gesture comfortably framed. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }

  .join-modal__welcome-wash {
    /* Lighter than the previous pass, which read as almost pure white and
       lost Rob, the room, and the wall art/guitars entirely. This keeps a
       light overall fade (the PDF's photo IS faded, just not this heavily)
       and leaves legibility for the caption to a second, local backing on
       .join-modal__welcome-copy below instead of washing the whole card.

       pointer-events: none — this is a decorative, aria-hidden tint sitting
       (in DOM/paint order) above the real <video>. Without this, it — and
       .join-modal__welcome-copy below — silently ate every click over the
       card, including Chrome's native center play-button hit target, since
       plain DOM order beats the video's own internal controls when nothing
       has an explicit z-index. Confirmed via elementFromPoint at the
       video's center: it resolved to the caption text, never the video.

       Hidden until the video actually finishes — see the `ended`/`play`
       listeners below, which toggle --ended on .join-modal__welcome-card.
       This wash is now specifically part of the END-STATE reveal (the
       sign-off's legibility backing), not a treatment visible during
       poster/playback. */
    position: absolute;
    pointer-events: none;
    inset: 0;
    opacity: 0;
    transition: opacity var(--g8-dur-slow) var(--g8-ease);
    background: linear-gradient(
      180deg,
      rgba(245, 244, 240, 0) 0%,
      rgba(245, 244, 240, 0) 52%,
      rgba(245, 244, 240, 0.12) 70%,
      rgba(245, 244, 240, 0.26) 100%
    );
  }
  .join-modal__welcome-card--ended .join-modal__welcome-wash {
    opacity: 1;
  }

  .join-modal__welcome-copy {
    /* Positioned to match the measured caption block: text starting ~60%
       down the card, signature ending ~83% down. Its own light-to-solid
       backing (independent of the card-wide wash above) keeps the text and
       signature legible over the now-more-visible photo without needing to
       wash out the whole card to get there.

       Now that the card holds a real <video controls> (not a static photo),
       the browser's own control bar renders pinned to the card's bottom
       edge whenever paused — the same strip this panel used to have all to
       itself for the signature. Extra bottom padding (native Chrome's bar
       measures ~34px here) reserves that strip so the bar sits in the
       gradient's opaque zone below the sign-off instead of drawing through
       it. Trimmed from the earlier 38-48px down to 34-38px — this box is
       bottom-anchored and shrink-wraps to its content, so the message's
       distance from the card's TOP is entirely a function of what's below
       it (text height + this gap + signature height + this padding); with
       font size and signature size both off-limits, this padding and the
       text-to-signature gap below are the only levers left to pull the
       message down away from the center Play control. Floor kept at 34px
       (the bar's own measured height) plus a small few px of breathing
       room — never less than the bar itself needs.

       pointer-events: none for the same reason as the wash above — this
       panel has no interactive content (the text/signature don't need to
       be clickable), so it must not sit in the way of clicks meant for the
       video/native controls underneath. Verified with elementFromPoint:
       this was the actual element receiving clicks aimed at the center
       play button before this fix.

       Alpha reduced ~22% off both non-zero stops (0.8→0.62, 0.92→0.72) —
       the same gradient shape, just a lighter veil, so Rob/the room read
       through more while the text/signature keep enough backing to stay
       readable. */
    position: absolute;
    pointer-events: none;
    left: 0;
    right: 0;
    bottom: 0;
    /* 10px trimmed off the desktop floor (34px→28px) purely to open up a
       little more breathing room above the message, below Safari's centered
       Play button — this box is bottom-anchored and shrink-wraps to its
       content, so this bottom padding is the only remaining lever once
       font size, the text-to-signature gap, and the signature itself are
       all off the table. Mobile keeps a smaller 4px trim (34px→30px, see
       the @media override below) since its control bar has less proven
       slack to give up. */
    padding: 14px 18px 28px;
    text-align: center;
    background: linear-gradient(
      180deg,
      rgba(245, 244, 240, 0) 0%,
      rgba(245, 244, 240, 0.3) 30%,
      rgba(245, 244, 240, 0.42) 100%
    );
    /* Hidden until the video ends (same mechanism/reasoning as the wash
       above): no message/signature during poster or playback, revealed
       only on the native `ended` event, hidden again on `play` (covers
       Replay) — see the script below. */
    opacity: 0;
    transition: opacity var(--g8-dur-slow) var(--g8-ease);
  }
  .join-modal__welcome-card--ended .join-modal__welcome-copy {
    opacity: 1;
  }

  .join-modal__welcome-text {
    /* JostRoman-SemiBold 28pt per the PDF = 1.458vw on the 1920 canvas. */
    margin: 0;
    font-family: var(--g8-font-ui);
    font-weight: var(--g8-weight-ui);
    font-size: clamp(13px, 2.05cqw, 28px);
    line-height: 1.35;
    color: var(--g8-midnight);
  }

  .join-modal__welcome-sig {
    /* Scaled up alongside the message above it so the two keep reading as
       one signed note, not a full sentence next to a barely-there scrawl.
       Gap to the message above tightened from 8px to 4px — the other lever
       (besides the control-safe padding above) for pulling the message
       down away from the center Play control without touching font size
       or the signature's own dimensions. */
    display: block;
    width: clamp(100px, 14.08cqw, 160px);
    height: auto;
    margin: 4px auto 0;
    /* Same handwritten-upward-slant convention as the About page's
       signature (src/pages/about.astro, .founder__sig-img): a
       counterclockwise rotate(-5deg) around the left edge reads as the
       tail (right side) lifting above the start (left side), not the
       whole mark spinning. translateX runs BEFORE rotate in the function
       list so it's a plain horizontal shift off the box's originally-
       centered position (margin: auto), not a shift along the rotated
       axis — a subtle nudge right, not a re-centering. */
    transform: translateX(16px) rotate(-5deg);
    transform-origin: left center;
  }

  .join-modal__return {
    /* HelveticaNeue-Medium 28pt per the PDF — Inter, not Jost, at the same
       rate the rest of the "Inter chrome" text uses. */
    display: block;
    margin: clamp(12px, 2.82cqw, 24px) auto 0;
    background: none;
    border: none;
    padding: 0;
    font-family: var(--g8-font-inter);
    font-weight: 500;
    font-size: clamp(15px, 2.05cqw, 28px);
    color: var(--g8-open-water);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .join-modal__return:hover { color: var(--g8-golden-hour); }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 1023px) {
    .join__headline { text-shadow: 3px 3px 0 var(--g8-midnight); }
  }

  @media (max-width: 900px) {
    /* The strict 1.756:1 shell above is a desktop-only target (the PDF's
       own comp is desktop-only) — a single, stacked column of content
       needs more height than that ratio allows, so tablet/mobile fall
       back to width-driven sizing with a generous max-height and scroll
       as the safety net, same as the previous working pass. */
    .join-modal__panel {
      width: min(88vw, 640px);
      max-width: none;
      aspect-ratio: auto;
      max-height: 85vh;
    }
    /* Single column, so the grid's row-major auto-placement (built for the
       desktop 2-col alignment — see .join-modal__grid's own comment) would
       otherwise interleave the two sides here: heading, heading, promise,
       field, promise, field... reading as neither "all the pledge, then
       all the subscribe" nor anything else coherent. `order` restores the
       original sequential reading flow (I promise: → its 3 paragraphs →
       its checkbox → Subscribe → its 3 fields → its checkbox) without
       touching the desktop markup/DOM order the alignment above depends
       on. Indexed by nth-child position in the flat markup: 1/3/5/7/9 are
       the pledge side, 2/4/6/8/10 the subscribe side, 11/12 the button/
       error (unstyled by nth-child, so they'd default to order:0 and jump
       to the front if left unset here). */
    .join-modal__grid > *:nth-child(1) { order: 1; }  /* I promise: */
    .join-modal__grid > *:nth-child(3) { order: 2; }  /* promise para 1 */
    .join-modal__grid > *:nth-child(5) { order: 3; }  /* promise para 2 */
    .join-modal__grid > *:nth-child(7) { order: 4; }  /* promise para 3 (em) */
    .join-modal__grid > *:nth-child(9) { order: 5; }  /* I hereby promise */
    .join-modal__grid > *:nth-child(2) { order: 6; }  /* Subscribe */
    .join-modal__grid > *:nth-child(4) { order: 7; }  /* First name field */
    .join-modal__grid > *:nth-child(6) { order: 8; }  /* Email field */
    .join-modal__grid > *:nth-child(8) { order: 9; }  /* Zipcode field */
    .join-modal__grid > *:nth-child(10) { order: 10; } /* Get invites... */
    .join-modal__grid > *:nth-child(11) { order: 11; } /* submit button */
    .join-modal__grid > *:nth-child(12) { order: 12; } /* error message */
    .join-modal__grid { grid-template-columns: 1fr; gap: 32px; }
    /* Smaller trim than desktop's (34px→30px, not →28px) — less proven
       slack to give up on a card this small before risking the native
       control bar. */
    .join-modal__welcome-copy { padding-bottom: 30px; }
  }

  @media (min-width: 901px) {
    /* Desktop only — measured off the PDF, the modal's top edge sits at
       ~11% of viewport height, not vertically centered in the available
       space (which is what centering was producing, since the shell isn't
       tall enough to reach the middle of a typical viewport on its own).
       Shared by pages 6 and 7, same as the shell dimensions above. */
    .join-modal:not([hidden]) {
      align-items: flex-start;
    }
    .join-modal {
      padding-top: clamp(40px, 11vh, 140px);
    }
  }

  @media (max-width: 680px) {
    /* The shared 100svh (g8-section-panel, global.css) is a desktop/tablet
       reading of the scroll — at phone width this should be exactly as
       tall as its own content, not a full-screen box with a small centered
       card floating in a lot of empty space above and below it. (The
       equivalent reset for .podcast-teaser/.jams-teaser lives in
       index.astro, where those sections are actually authored — Astro's
       per-file style scoping means a rule targeting .join written there
       never matches this element, since .join is authored here.) */
    .join { height: auto; }
    .join { padding-block: 56px 48px; }
    .join__subhead { font-size: 15px; }
    .join__media { margin: 32px 0 28px; }

    .join-modal { padding: 0; }
    .join-modal__panel {
      width: 100%;
      height: 100%;
      max-height: 100vh;
      border-radius: 0;
      border-width: 0;
      box-shadow: none;
    }
    .join-modal__view { padding: 20px 20px 32px; }
    .join-modal__close { top: 14px; right: 14px; }
    .join-modal__heading {
      /* Symmetric inline padding keeps the centered heading clear of the
         close button pinned top-right — without it, a wide heading like
         "Welcome to The Gr8ful Project" runs straight under the button on
         a phone-width panel. */
      padding-inline: 42px;
      font-size: 22px;
      margin-top: 6px;
      /* A 2px hard shadow at this font size reads as doubled/blurred
         letterforms rather than a crisp offset — halved just at this
         breakpoint, where the heading is smallest. */
      text-shadow: 1px 1px 0 var(--g8-midnight);
    }
  }
