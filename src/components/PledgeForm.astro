---
/**
 * The pledge form. Posts to /api/pledge, which adds the contact to Brevo.
 *
 * With JavaScript the submit is intercepted so a failure can be shown inline
 * without losing what was typed. Without it the browser posts natively and
 * the route redirects; either way the browser's own validation holds the
 * required fields.
 *
 * `validate` mirrors the home-page prototype: the CTA stays dimmed and
 * disabled until the pledge box is checked and the email parses. The /pledge
 * page renders the plain variant, as drawn.
 */
interface Props {
  validate?: boolean;
}

const { validate = false } = Astro.props;
---

<form
  class="pledge g8-card"
  method="post"
  action="/api/pledge"
  data-pledge-form
  data-validate={validate ? 'true' : undefined}
>
  <label class="pledge__check">
    <input type="checkbox" name="pledged" required data-pledge-check />
    <span class="pledge__check-label">I take the pledge.</span>
  </label>

  <div class="pledge__field">
    <span class="g8-label">Email</span>
    <input
      type="email"
      name="email"
      placeholder="you@email.com"
      required
      autocomplete="email"
      data-pledge-email
    />
  </div>

  <label class="pledge__check">
    <input type="checkbox" name="nearBoulder" class="pledge__check--teal" />
    <span class="pledge__check-label pledge__check-label--quiet">
      I live around Boulder, Colorado.
    </span>
  </label>

  {/* Honeypot: off-screen and skipped by tab, so only bots fill it. */}
  <div class="pledge__trap" aria-hidden="true">
    <label>
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <button type="submit" class="pledge__submit" data-pledge-submit>Take the Pledge</button>

  <p class="pledge__error" data-pledge-error hidden role="alert"></p>

  <p class="pledge__fine">
    We'll send an occasional note and event invites. Easy to leave anytime.
  </p>
</form>

<script>
  const EMAIL = /.+@.+\..+/;

  document.querySelectorAll<HTMLFormElement>('[data-pledge-form]').forEach((form) => {
    const check = form.querySelector<HTMLInputElement>('[data-pledge-check]');
    const email = form.querySelector<HTMLInputElement>('[data-pledge-email]');
    const submit = form.querySelector<HTMLButtonElement>('[data-pledge-submit]');
    const gated = form.dataset.validate === 'true';

    const sync = () => {
      if (!gated || !submit) return;
      const ready = Boolean(check?.checked) && EMAIL.test(email?.value ?? '');
      submit.disabled = !ready;
      submit.style.opacity = ready ? '1' : '0.45';
    };

    if (gated) {
      check?.addEventListener('change', sync);
      email?.addEventListener('input', sync);
      sync();
    }

    const error = form.querySelector<HTMLElement>('[data-pledge-error]');
    const trap = form.querySelector<HTMLInputElement>('input[name="website"]');
    const label = submit?.textContent ?? 'Take the Pledge';

    const showError = (message: string) => {
      if (!error) return;
      error.textContent = message;
      error.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (error) error.hidden = true;

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            pledged: Boolean(check?.checked),
            email: email?.value ?? '',
            nearBoulder: Boolean(
              form.querySelector<HTMLInputElement>('input[name="nearBoulder"]')?.checked
            ),
            website: trap?.value ?? '',
          }),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok && result?.ok) {
          window.location.assign('/pledge/thanks');
          return;
        }

        showError(result?.message ?? 'Something went wrong. Please try again.');
      } catch {
        // Offline or the request never landed — keep their input, let them retry.
        showError('We couldn’t reach the server. Please check your connection and try again.');
      }

      if (submit) {
        submit.disabled = false;
        submit.textContent = label;
        sync();
      }
    });
  });
</script>

<style>
  .pledge {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .pledge__check {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    cursor: pointer;
  }

  .pledge__check input[type='checkbox'] {
    width: 22px;
    height: 22px;
    margin: 1px 0 0;
    accent-color: var(--g8-crimson);
    flex: 0 0 auto;
  }
  .pledge__check input.pledge__check--teal { accent-color: var(--g8-deep-teal); }

  .pledge__check-label {
    font-size: 17px;
    line-height: 1.5;
    font-weight: 500;
  }
  .pledge__check-label--quiet {
    font-size: 15px;
    font-weight: 400;
    color: var(--g8-text-muted);
  }

  .pledge__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pledge__field input {
    font-family: var(--g8-font-body);
    font-size: 16px;
    padding: 15px 18px;
    background: var(--g8-bg);
    border: var(--g8-stroke) solid var(--g8-border-strong);
    border-radius: 12px;
    color: var(--g8-midnight);
    outline: none;
  }
  .pledge__field input::placeholder { color: #7c848d; }
  .pledge__field input:focus-visible {
    outline: 2px solid var(--g8-focus);
    outline-offset: 2px;
  }

  .pledge__submit {
    font-family: var(--g8-font-ui);
    font-weight: var(--g8-weight-ui);
    font-size: 16px;
    letter-spacing: var(--g8-track-ui);
    text-transform: uppercase;
    background: var(--g8-action);
    color: var(--g8-action-text);
    border: var(--g8-stroke) solid var(--g8-border-strong);
    border-radius: var(--g8-radius-pill);
    padding: 17px 28px;
    cursor: pointer;
    transition: background-color var(--g8-dur-fast) var(--g8-ease);
  }
  .pledge__submit:hover:not(:disabled) { background: var(--g8-action-hover); }
  .pledge__submit:disabled { cursor: not-allowed; }

  /* Out of sight and out of the tab order, but not display:none — some bots
     skip hidden fields, which would defeat the point. */
  .pledge__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .pledge__error {
    margin: 0;
    font-size: 15px;
    line-height: var(--g8-lh-body);
    color: var(--g8-crimson);
  }

  .pledge__fine {
    margin: 0;
    font-size: 13px;
    line-height: var(--g8-lh-body);
    color: var(--g8-text-muted);
  }

  @media (max-width: 680px) {
    .pledge { padding: 28px 24px; }
  }
</style>
