---
/**
 * One Jams card, rendered from Rob's flattened artwork — see the header
 * comment in src/data/jams.ts for the full context. This component does
 * NOT construct any part of the card (no CSS photo layout, no live text
 * band, no CSS/SVG Play button) — `image` is the entire visible card, laid
 * out at its own native aspect ratio and never cropped, stretched, or
 * distorted.
 *
 * The only thing this component adds on top of the artwork is, for a
 * published card with a working video, a transparent <a> sized and
 * positioned in PERCENTAGES of the image's own natural dimensions (see
 * JamHotspot in jams.ts) — so the clickable area tracks the baked-in Play
 * button exactly as the whole card scales, at any breakpoint, without any
 * JS measuring anything.
 *
 * For the previous CSS-constructed design, see JamCardLegacy.astro +
 * jamsLegacy.ts (preserved, not deleted — revert steps in that file's own
 * header comment).
 */
import type { JamCardData } from '../data/jams';

interface Props extends JamCardData {
  /**
   * Cards after the first repeat across the row today (all "coming soon"
   * artwork), so their images are kept out of the accessibility tree to
   * avoid announcing similar content four times — same reasoning/behavior
   * as the legacy component and the homepage's other repeating-card
   * sections. Once every card is genuinely distinct this can just be
   * dropped.
   */
  decorative?: boolean;
}

const { artistName, image, status, videoUrl, hotspot, decorative = false } = Astro.props as Props;

const isPublished = status === 'published';
const isInteractive = isPublished && Boolean(videoUrl) && Boolean(hotspot);

const altText = decorative
  ? ''
  : isPublished
    ? `${artistName} performing`
    : `${artistName} — coming soon`;
---

<div
  class:list={['jam-card', isPublished ? 'jam-card--published' : 'jam-card--coming-soon']}
  data-status={status}
>
  <img
    src={image}
    alt={altText}
    aria-hidden={decorative ? 'true' : undefined}
    class="jam-card__art"
  />

  {isInteractive && (
    <a
      class="jam-card__hotspot"
      href={videoUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Watch ${artistName} — opens in a new tab`}
      style={`left:${hotspot!.left}%; top:${hotspot!.top}%; width:${hotspot!.width}%; height:${hotspot!.height}%;`}
    />
  )}
</div>

<style>
  /* Native 787×1352 — matches every current jam_*.webp exactly (see the
     note in jams.ts). object-fit:contain rather than cover: with the
     container locked to the artwork's own ratio the two are equivalent in
     practice (nothing to crop either way), but contain is the correct
     choice on principle — it can never crop, regardless of any future
     mismatch, where cover silently would. */
  .jam-card {
    position: relative;
    display: block;
    aspect-ratio: 787 / 1352;
    border-radius: var(--g8-radius-lg);
    overflow: hidden;
  }
  .jam-card__art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Purely interactive — no visible fill of its own. The Play button
     everyone sees IS the artwork underneath; this only adds a real,
     keyboard-reachable click/tap target precisely over it. Positioned in
     %, set inline from `hotspot` above (percentages of the image's own
     natural size), so it scales with the artwork rather than the
     viewport. */
  .jam-card__hotspot {
    position: absolute;
    display: block;
    background: transparent;
  }
  .jam-card__hotspot:focus-visible {
    outline: 2px solid var(--g8-focus);
    outline-offset: 2px;
    border-radius: var(--g8-radius-pill);
  }

  @media (max-width: 680px) {
    /* Same mobile sizing the legacy cards used — width-driven, capped, one
       scroll-snap strip — untouched by the artwork swap. */
    .jam-card {
      flex: 0 0 auto;
      width: 62vw;
      max-width: 260px;
      scroll-snap-align: start;
    }
    .jam-card:first-child { margin-left: 0; }
  }
</style>
