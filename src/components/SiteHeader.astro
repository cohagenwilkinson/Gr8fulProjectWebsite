---
import { navLinks, type NavLink } from '../data/site';

/**
 * Shared chrome — edit once, every page follows.
 * Desktop matches SiteHeader.dc.html exactly. Below 900px the nav collapses
 * behind a Menu toggle; the pledge CTA never leaves the bar.
 *
 * `transparent` is a homepage-only variant (passed via BaseLayout's
 * `transparentHeader` prop): the bar overlays the hero video instead of
 * sitting on its own solid band, with its own logo, flat nav list, and
 * outlined CTA — matching page 1 of the approved redesign. It does not
 * touch `navLinks` or any other route; every other page renders exactly as
 * before.
 *
 * `homeNav` (via BaseLayout's `homeNav` prop) opts a solid-background page
 * into that same flat link set + outlined "Join the Project" CTA, without
 * the overlay chrome — there's no hero video on these pages for a
 * transparent bar to sit over, and the overlay's white nav text would be
 * unreadable against a solid light bar, so it keeps the standard bar's
 * background and midnight text. Currently just /about. Homepage itself is
 * untouched either way.
 */
interface Props {
  transparent?: boolean;
  homeNav?: boolean;
}

const { transparent = false, homeNav = false } = Astro.props;

/**
 * Flat homepage-hero nav — no Events dropdown, no Van, PDF-approved order.
 * Podcast/Jams/Seva point at their own homepage sections (not the standalone
 * /podcast, /jams, /pbj pages) per instruction — those pages are still
 * reachable via the section CTAs ("See all episodes →", "See all JAMS →")
 * and via the regular (non-transparent) header used on every other route,
 * which is untouched. Shared by both the homepage's transparent header and
 * any solid page opting in via `homeNav`.
 */
const heroNavLinks: NavLink[] = [
  { label: 'Home', href: '/' },
  { label: 'Podcast', href: '/#podcast' },
  { label: 'Jams', href: '/#jams' },
  { label: 'Seva', href: '/#seva' },
  { label: 'About', href: '/about' },
];

const links = transparent || homeNav ? heroNavLinks : navLinks;
const showJoinCta = transparent || homeNav;
---

<header class:list={['header', { 'header--overlay': transparent }]}>
  <div class="g8-container header__bar">
    <a href="/" class="header__logo">
      {
        transparent ? (
          <img src="/gr8ful-logo-hero.png" alt="Gr8ful Project" width="104" height="44" />
        ) : (
          <img src="/gr8ful-logo.png" alt="Gr8ful Project" width="106" height="44" />
        )
      }
    </a>

    <nav class="header__nav" aria-label="Primary">
      {
        links.map((link) =>
          link.children ? (
            <div class="header__group">
              <a href={link.href} class="header__parent">
                {link.label}
                <span class="header__caret" aria-hidden="true" />
              </a>
              <div class="header__dropdown">
                {link.children.map((child) => (
                  <a href={child.href}>{child.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={link.href}>{link.label}</a>
          )
        )
      }
    </nav>

    {
      showJoinCta ? (
        <a href="/#join" class="g8-btn g8-btn--cta g8-btn--cta-sm header__cta header__cta--outline">
          Join the Project
        </a>
      ) : (
        <a href="/pledge" class="g8-btn g8-btn--primary g8-btn--sm g8-btn--shadow header__cta">
          Take the Pledge
        </a>
      )
    }

    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="header-menu"
      data-menu-toggle
    >
      Menu
    </button>
  </div>

  <nav class="header__menu" id="header-menu" aria-label="Primary, compact" hidden>
    {
      links.map((link) => (
        <>
          <a href={link.href}>{link.label}</a>
          {link.children?.map((child) => (
            <a href={child.href} class="header__menu-child">
              {child.label}
            </a>
          ))}
        </>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('header-menu');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.textContent = open ? 'Menu' : 'Close';
    menu?.toggleAttribute('hidden', open);
  });

  // Scrolls nav links that point at a homepage section (/#podcast, /#jams,
  // /#seva, /#join) to that section when already on that page. Links to a
  // fragment on a DIFFERENT route are left alone entirely, so the browser
  // does a normal navigation there and lands via its native load-time
  // fragment scroll once the target page arrives.
  //
  // Deliberately instant (behavior:'auto'), not smooth — tested both CSS
  // `scroll-behavior: smooth` (see global.css) and this handler with
  // `behavior: 'smooth'`, and in testing neither animation ever completed;
  // scrollY stayed at 0 indefinitely even though the click/preventDefault
  // and hash update all fired correctly. Instant scroll is what's actually
  // been verified to land on the right section every time, which matters
  // more here than the animation.
  document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
    const href = link.getAttribute('href') ?? '';
    const hashIndex = href.indexOf('#');
    if (hashIndex === -1) return;
    const path = href.slice(0, hashIndex) || '/';
    const id = href.slice(hashIndex + 1);
    if (!id || path !== location.pathname) return;

    link.addEventListener('click', (event) => {
      const target = document.getElementById(id);
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: 'auto', block: 'start' });
      history.pushState(null, '', href);
      // aria-expanded lives on the toggle, not the menu — close the
      // compact drawer the same way the toggle's own handler does.
      if (!menu?.hasAttribute('hidden')) {
        toggle?.setAttribute('aria-expanded', 'false');
        toggle && (toggle.textContent = 'Menu');
        menu?.setAttribute('hidden', '');
      }
    });
  });
</script>

<style>
  .header {
    position: relative;
    z-index: 5;
    background: var(--g8-chalk);
    border-bottom: var(--g8-stroke) solid var(--g8-border-strong);
    font-family: var(--g8-font-body);
  }

  /* Homepage-only: floats transparently over the hero video. Scoped to this
     modifier class so every other route keeps the solid bar untouched. */
  .header.header--overlay {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 20;
    background: transparent;
    border-bottom: 0;
  }

  /* Left/right inset shared with every homepage chapter via --g8-hero-inset
     (tokens.css) — logo left edge, hero content, and every section's own
     head row all reference that one variable now, instead of each repeating
     the same clamp() literally and risking drift between them. */
  .header--overlay .header__bar {
    /* Full-bleed, not the capped-and-centered .g8-container: at wide
       viewports the container's own max-width auto-margin would stack with
       this gutter and blow well past the PDF's measured inset. */
    max-width: none;
    margin-inline: 0;
    --g8-page-gutter: var(--g8-hero-inset);
    padding-block: clamp(40px, 9vh, 90px) 16px;
  }

  .header--overlay .header__logo img {
    /* PDF logo is 15.9% of canvas width — scale with viewport instead of a
       fixed px pair, floored so it never gets illegibly small on phones. */
    width: clamp(120px, 15.9vw, 320px);
    height: auto;
  }

  .header--overlay .header__nav {
    /* Nav is right-anchored to the CTA via margin-left:auto — this stays a
       touch tighter than the default gap above so the cluster still reads
       as compact against the CTA, matching the PDF's proportions, but
       scales up with the link text rather than staying flat. Rolled back
       to the pre-scale-review size — Safari had been zoomed out during
       evaluation, which made the enlarged pass look correct when it
       wasn't, at 100%/Actual Size. */
    gap: clamp(18px, 1.8vw, 26px);
  }

  .header--overlay .header__nav a {
    color: var(--g8-chalk);
    font-weight: 400;
    white-space: nowrap;
  }
  .header--overlay .header__nav a:hover { color: var(--g8-golden-hour); }
  .header--overlay .header__dropdown a { color: var(--g8-midnight); }

  .header--overlay .header__toggle {
    color: var(--g8-chalk);
    border-color: var(--g8-chalk);
  }

  /* The compact drawer still needs a solid ground once opened — it's a
     dropdown of stacked links, not something meant to float over video. */
  .header--overlay .header__menu:not([hidden]) {
    background: var(--g8-chalk);
    box-shadow: var(--g8-shadow-soft);
  }

  .header__bar {
    padding-block: 16px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .header__logo img {
    display: block;
    height: 44px;
    width: auto;
  }

  .header__nav {
    /* Keynote sets nav links in HelveticaNeue (Regular) 28pt — web: Inter.
       Fluid off the 1920 canvas, floored so the bar doesn't overflow
       narrower desktop/tablet widths (the nav collapses to the drawer
       below 900px anyway, so the floor only has to hold from there up).
       Rolled back to the pre-scale-review size — an intermediate pass had
       pushed this larger while Safari was zoomed out during evaluation,
       which read as correct then but is too large at 100%/Actual Size. */
    display: flex;
    align-items: center;
    gap: clamp(22px, 2vw, 32px);
    margin-left: auto;
    font-family: var(--g8-font-inter);
    font-weight: 400;
    font-size: clamp(17px, 1.46vw, 22px);
    letter-spacing: 0;
  }
  .header__nav a {
    color: var(--g8-midnight);
    text-decoration: none;
    transition: color var(--g8-dur-fast) var(--g8-ease);
  }
  .header__nav a:hover { color: var(--g8-ember); }

  /* Parent items open on hover and on keyboard focus, so the dropdown is
     reachable by tab as well as by mouse. The parent is still a real link,
     which is what touch devices land on. */
  .header__group { position: relative; }

  .header__parent {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .header__caret {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
    transition: transform var(--g8-dur-fast) var(--g8-ease);
  }
  .header__group:hover .header__caret,
  .header__group:focus-within .header__caret {
    transform: rotate(180deg);
  }

  .header__dropdown {
    position: absolute;
    top: calc(100% + 17px);
    left: 50%;
    display: flex;
    flex-direction: column;
    min-width: 172px;
    padding: 6px;
    background: var(--g8-chalk);
    border: var(--g8-stroke) solid var(--g8-border-strong);
    border-radius: var(--g8-radius-md);
    box-shadow: var(--g8-shadow-soft);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -4px);
    transition:
      opacity var(--g8-dur-fast) var(--g8-ease),
      transform var(--g8-dur-fast) var(--g8-ease),
      visibility var(--g8-dur-fast);
  }

  /* Invisible bridge across the header padding, so travelling from the
     parent down to the panel doesn't cross a dead zone and close it. */
  .header__dropdown::before {
    content: '';
    position: absolute;
    inset: -17px 0 100%;
  }

  .header__group:hover .header__dropdown,
  .header__group:focus-within .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .header__dropdown a {
    padding: 9px 12px;
    border-radius: var(--g8-radius-sm);
    white-space: nowrap;
    transition:
      color var(--g8-dur-fast) var(--g8-ease),
      background var(--g8-dur-fast) var(--g8-ease);
  }
  .header__dropdown a:hover { background: var(--g8-surface); }

  /* Compact nav — hidden until the bar runs out of room. */
  .header__cta { white-space: nowrap; }

  .header__cta--outline {
    background: transparent;
    color: var(--g8-golden-hour);
    border: var(--g8-stroke) solid var(--g8-golden-hour);
    box-shadow: none;
  }
  .header__cta--outline:hover {
    background: var(--g8-golden-hour);
    color: var(--g8-midnight);
  }

  .header__toggle {
    display: none;
    margin-left: auto;
    white-space: nowrap;
    font-family: var(--g8-font-ui);
    font-weight: var(--g8-weight-ui);
    font-size: 14px;
    letter-spacing: var(--g8-track-ui);
    text-transform: uppercase;
    color: var(--g8-midnight);
    background: transparent;
    border: var(--g8-stroke) solid var(--g8-border-strong);
    border-radius: var(--g8-radius-pill);
    padding: 10px 20px;
    cursor: pointer;
  }

  .header__menu {
    display: none;
    flex-direction: column;
    border-top: 1px solid var(--g8-border);
    padding: 8px var(--g8-page-gutter) 20px;
    font-family: var(--g8-font-ui);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: 0.04em;
  }
  .header__menu a {
    color: var(--g8-midnight);
    text-decoration: none;
    padding: 14px 0;
    border-bottom: 1px solid var(--g8-border);
  }
  .header__menu a:hover { color: var(--g8-ember); }

  .header__menu-child {
    padding-left: 18px;
    font-size: 15px;
    color: var(--g8-text-muted);
  }

  @media (max-width: 900px) {
    .header__bar { gap: 20px; }
    .header__nav { display: none; }
    /* CTA and Menu group to the right once the nav collapses. */
    .header__cta { margin-left: auto; }
    .header__toggle { display: block; margin-left: 0; }
    .header__menu:not([hidden]) { display: flex; }
  }

  @media (max-width: 520px) {
    .header__bar { gap: 12px; }
    .header__logo img { height: 36px; }
    .header__cta { font-size: 12px; letter-spacing: 0.04em; padding: 10px 14px; }
    .header__toggle { font-size: 12px; padding: 9px 14px; }
  }
</style>
