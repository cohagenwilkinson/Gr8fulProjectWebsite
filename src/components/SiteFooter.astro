---
import ColorRibbon from './ColorRibbon.astro';
import { site, socialLinks } from '../data/site';

/**
 * Shared chrome. One row: socials + email left, mobius center, pledge right.
 * Privacy sits alone at the very bottom. No form here by design — the
 * footer CTA links to /pledge.
 */
---

<footer class="footer">
  <ColorRibbon variant="footer" />
  <div class="g8-container footer__row">
    <div class="footer__links">
      {socialLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </div>

    <img class="footer__mobius" src="/mobius.png" alt="Gr8ful Project mobius mark" />

    <a href="/pledge" class="g8-btn g8-btn--gold footer__pledge">Take the Pledge</a>
  </div>

  <div class="footer__base">
    <a href="/privacy">Privacy</a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--g8-midnight);
    overflow: hidden;
    font-family: var(--g8-font-body);
  }

  .footer__row {
    padding-block: 44px 32px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 28px;
    font-family: var(--g8-font-ui);
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .footer__mobius {
    height: 96px;
    width: auto;
  }

  .footer__pledge { justify-self: end; }

  .footer__base {
    display: flex;
    justify-content: center;
    padding-bottom: 32px;
    font-family: var(--g8-font-ui);
    font-size: 13px;
    letter-spacing: 0.04em;
  }

  .footer a:not(.g8-btn) {
    color: var(--g8-sea-glass);
    text-decoration: none;
    transition: color var(--g8-dur-fast) var(--g8-ease);
  }
  .footer a:not(.g8-btn):hover { color: var(--g8-golden-hour); }

  @media (max-width: 900px) {
    .footer__row {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding-block: 36px 24px;
      gap: 24px;
    }
    .footer__links { justify-content: center; }
    .footer__mobius { order: -1; }
    .footer__pledge { justify-self: center; }
    .footer__base { padding-bottom: 28px; }
  }

  @media (max-width: 680px) {
    .footer__mobius { height: 72px; }
  }
</style>
