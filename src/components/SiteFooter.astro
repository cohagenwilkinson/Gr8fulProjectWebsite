---
import ColorRibbon from './ColorRibbon.astro';
import { site, socialLinks } from '../data/site';
import { privacyLastUpdated, privacySections } from '../data/privacy';

/**
 * Shared chrome. One row: social icons + email left, mobius center, Privacy
 * right. No form here by design.
 *
 * The "Take the Pledge" CTA that used to sit here has been removed — the
 * Join section, its own CTA, and the pledge flow are unchanged, this was
 * only the redundant footer shortcut to it.
 *
 * Icons use the verified URLs already in data/site.ts (socialLinks) —
 * nothing invented here. Minimal inline SVGs, not brand assets, so no
 * separate icon files/dependency; keyed by label since socialLinks is
 * {label, href} pairs.
 *
 * Privacy is a button that opens an on-site modal, not a link to /privacy —
 * per instruction, visitors should never leave the current page for it.
 * NOTE: /privacy itself was already a local page in this project, not an
 * external redirect to an old site (see data/privacy.ts) — its content is
 * what the modal below reuses verbatim. The standalone /privacy route is
 * left in place untouched, for any direct link/bookmark to it.
 */
const socialIcons: Record<string, string> = {
  YouTube:
    'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5V8.5L15.8 12l-6.2 3.5Z',
  TikTok:
    'M16.5 2h-3.1v13.6a2.9 2.9 0 1 1-2.9-2.9c.2 0 .5 0 .7.1v-3.2a6.1 6.1 0 1 0 5.3 6V9.3a7.7 7.7 0 0 0 4.6 1.5V7.7a4.6 4.6 0 0 1-4.6-4.6V2Z',
};
---

<footer class="footer">
  <ColorRibbon variant="footer" />
  <div class="footer__row">
    <div class="footer__links">
      <div class="footer__socials">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              class="footer__social-link"
              aria-label={`${site.name} on ${link.label}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label === 'Instagram' ? (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                  <path d={socialIcons[link.label]} />
                </svg>
              )}
            </a>
          ))
        }
      </div>
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </div>

    <img class="footer__mobius" src="/mobius.png" alt="Gr8ful Project mobius mark" />

    <div class="footer__cta">
      <button type="button" class="footer__privacy-trigger" data-privacy-open aria-haspopup="dialog">
        Privacy
      </button>
      {/*
        gr8ful-logo-hero.png, not the dark gr8ful-logo.png — this is the
        SAME asset the Hero's transparent header uses (SiteHeader.astro),
        reused verbatim because it's the light/golden colorway meant to sit
        on a dark ground, same as this midnight footer. The plain dark
        logo would be invisible here. Not recolored, not recreated — sized
        as a real brand sign-off, right-aligned to the same guide the rest
        of the homepage scrolls against, with Privacy inline beside it
        (between the center 8 and the wordmark) rather than stacked below.
      */}
      <img class="footer__wordmark" src="/gr8ful-logo-hero.png" alt="Gr8ful Project" width="104" height="44" />
    </div>
  </div>

  <div class="privacy-modal" data-privacy-modal hidden>
    <div class="privacy-modal__backdrop" data-privacy-close aria-hidden="true"></div>
    <div
      class="privacy-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="privacy-modal-heading"
      tabindex="-1"
    >
      <div class="privacy-modal__header">
        <div>
          <div class="g8-eyebrow privacy-modal__label">{privacyLastUpdated}</div>
          <h2 id="privacy-modal-heading" class="privacy-modal__heading">Privacy</h2>
        </div>
        <button
          type="button"
          class="privacy-modal__close"
          data-privacy-close
          aria-label="Close privacy policy"
        >
          ✕
        </button>
      </div>

      <div class="privacy-modal__body">
        {
          privacySections.map((section) => (
            <div class="privacy-modal__section">
              <h3 class="privacy-modal__section-heading">{section.heading}</h3>
              <p class="privacy-modal__section-body">{section.body}</p>
            </div>
          ))
        }
        <div class="privacy-modal__section">
          <h3 class="privacy-modal__section-heading">Questions</h3>
          <p class="privacy-modal__section-body">
            Write to <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  // Accessible dialog: focus moves into the panel on open and back to the
  // Privacy button on close, Tab is trapped inside while open, Escape and
  // backdrop-click both close it, and the background can't scroll while
  // it's open. Present on every page (SiteFooter renders on all of them),
  // so this one script covers the homepage and every other route.
  const openBtn = document.querySelector<HTMLButtonElement>('[data-privacy-open]');
  const modal = document.querySelector<HTMLDivElement>('[data-privacy-modal]');
  const panel = modal?.querySelector<HTMLElement>('.privacy-modal__panel') ?? null;
  const closeEls = document.querySelectorAll<HTMLElement>('[data-privacy-close]');

  let lastFocused: HTMLElement | null = null;

  function getFocusable(): HTMLElement[] {
    if (!panel) return [];
    return Array.from(
      panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
    );
  }

  function onKeydown(event: KeyboardEvent) {
    if (event.key === 'Escape') {
      event.preventDefault();
      closeModal();
      return;
    }
    if (event.key !== 'Tab') return;
    const focusable = getFocusable();
    if (focusable.length === 0) {
      event.preventDefault();
      return;
    }
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  function openModal() {
    lastFocused = document.activeElement as HTMLElement;
    modal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    // Focus the panel itself (tabindex="-1", programmatically focusable
    // only) rather than the close button — this is a read-heavy dialog, so
    // a screen reader announcing the dialog + its title first, before
    // landing on a control, reads better than jumping straight to "Close".
    panel?.focus();
    document.addEventListener('keydown', onKeydown);
  }

  function closeModal() {
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKeydown);
    lastFocused?.focus();
  }

  openBtn?.addEventListener('click', openModal);
  closeEls.forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      closeModal();
    });
  });
</script>

<style>
  .footer {
    position: relative;
    background: var(--g8-midnight);
    overflow: hidden;
    font-family: var(--g8-font-body);
  }

  .footer__row {
    /* Full-bleed with the SAME left/right guide the homepage chapters use
       (--g8-hero-inset), not the standard .g8-container gutter — a footer
       that shares a right edge with LIFE/GRATITUDE, MUSIC/COMMUNITY, and
       SELFLESS/SERVICE above it reads as part of the same composition
       instead of falling back to a generic, narrower page margin. */
    /* position:relative — containing block for Privacy's absolute
       placement below, computed against this row specifically (not
       .footer, which also includes the ColorRibbon strip above it and
       would throw off top:50%). */
    position: relative;
    max-width: none;
    padding-inline: var(--g8-hero-inset);
    /* Tightened from 64/56 — with Privacy now inline beside the wordmark
       instead of stacked beneath it, the row no longer needs as much
       vertical air to read as intentional rather than sparse. */
    padding-block: 44px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 28px;
    /* Inter — footer text is utility/contact chrome, not editorial Jost
       voice. Was visibly small at 14px for a footer read at 100% zoom. */
    font-family: var(--g8-font-inter);
    font-size: 17px;
    letter-spacing: 0;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Icon substantially bigger — 22px was still reading as small utility
     chrome next to a 17px email address instead of a clearly clickable
     social link. Tap target grown to match. Color/hover/focus already
     come from the shared .footer a rules below. */
  .footer__social-link {
    display: grid;
    place-items: center;
    padding: 12px;
    border-radius: var(--g8-radius-md);
  }
  .footer__social-link svg { width: 30px; height: 30px; }

  .footer__mobius {
    /* Modest bump for optical balance now that both flanking groups have
       grown — this was already close to right. */
    height: 128px;
    width: auto;
  }

  .footer__cta {
    /* Privacy inline beside the wordmark now, both sitting on the same
       baseline as the socials/email/8 to their left — not a stacked
       column any more. Generous gap so Privacy reads as a distinct,
       breathing-room-having stop between the center 8 and the wordmark,
       not crowded against either. */
    justify-self: end;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
  }

  .footer__wordmark {
    /* Same asset as the Hero logo. ~25% bigger again (56→70px) so it reads
       as the brand sign-off now that it sits at the very end of one inline
       row rather than anchoring its own stacked corner — still clearly
       smaller than the Hero's own (which runs up to 320px wide there). */
    display: block;
    height: 70px;
    width: auto;
  }

  .footer a:not(.g8-btn) {
    color: var(--g8-sea-glass);
    text-decoration: none;
    transition: color var(--g8-dur-fast) var(--g8-ease);
  }
  .footer a:not(.g8-btn):hover { color: var(--g8-golden-hour); }

  /* Button, not a link — opens the modal instead of navigating. Same visual
     treatment as the other footer text links, since nothing about how it
     looks should signal "this one behaves differently".

     Desktop-only: taken out of the .footer__cta flex flow and placed at
     the true optical midpoint between the center 8 and the wordmark,
     rather than just sitting in the flex gap next to whichever one it's
     adjacent to. Both flanking positions move with viewport width, so this
     is derived algebraically, not a value read off one screenshot:

       mobius sits dead-center in the row (equal 1fr columns either side),
       so its right edge = 50vw + mobius_width/2 = 50vw + 43px (mobius is a
       fixed 128px-tall image, 86px wide at every viewport).

       the wordmark's right edge is pinned to the row's own right inset
       (var(--g8-hero-inset), which resolves to exactly 13vw across the
       whole desktop range this rule applies in — 900–2000px viewport,
       where the clamp()'s floor/ceiling aren't in play), so its left edge
       = 100vw − 13vw − wordmark_width = 87vw − 166px (wordmark is a fixed
       70px-tall image, 166px wide at every viewport, same reasoning).

       midpoint = (mobius_right + wordmark_left) / 2
                = (50vw + 43 + 87vw − 166) / 2 = 68.5vw − 61.5px

     Verified against live measurement at 1440px: formula gives 924.9px,
     the actual rendered midpoint between the two measured elements was
     924.85px. */
  .footer__privacy-trigger {
    position: absolute;
    left: calc(68.5vw - 61.5px);
    top: 50%;
    transform: translate(-50%, -50%);
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--g8-sea-glass);
    cursor: pointer;
    transition: color var(--g8-dur-fast) var(--g8-ease);
  }
  .footer__privacy-trigger:hover { color: var(--g8-golden-hour); }

  @media (max-width: 900px) {
    .footer__row {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding-block: 40px 44px;
      gap: 24px;
    }
    .footer__links { justify-content: center; }
    .footer__mobius { order: -1; }
    /* Back to a stacked column here — the single inline row is a desktop
       reading; forcing Privacy and the wordmark onto one line at phone
       width would crowd them. Privacy rejoins the normal flex flow (its
       desktop midpoint math is a wide-viewport calculation that doesn't
       apply once the layout is stacked) and lands back in its original
       spot above the wordmark, same as before. */
    .footer__cta { justify-self: center; flex-direction: column; align-items: center; gap: 16px; }
    .footer__privacy-trigger { position: static; transform: none; }
  }

  @media (max-width: 680px) {
    .footer__mobius { height: 92px; }
    .footer__wordmark { height: 52px; }
    .footer__row { padding-inline: 24px; }
  }

  /* ── Privacy modal ────────────────────────────────────── */
  .privacy-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    padding: clamp(16px, 4vw, 40px);
  }
  /* :not([hidden]) — an author display rule on this class would otherwise
     outrank the UA [hidden] { display:none } rule at equal specificity and
     render the modal open by default (same fix used on .header__menu and
     the Join modal elsewhere in this project). */
  .privacy-modal:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .privacy-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(1, 7, 21, 0.6);
  }

  .privacy-modal__panel {
    position: relative;
    width: min(620px, 100%);
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    background: var(--g8-parchment);
    border: var(--g8-stroke-bold) solid var(--g8-border-strong);
    border-radius: var(--g8-radius-lg);
    /* Hard, zero-blur offset shadow — same flat-offset language used
       everywhere else on the site, kept modest since this is legal copy,
       not a hero moment. */
    box-shadow: var(--g8-shadow-card);
    overflow: hidden;
  }
  .privacy-modal__panel:focus-visible { outline: none; }

  .privacy-modal__header {
    flex: none;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: clamp(24px, 4vw, 36px) clamp(24px, 4vw, 36px) 0;
  }

  .privacy-modal__label {
    display: block;
    margin-bottom: 8px;
    color: var(--g8-mesa);
  }

  .privacy-modal__heading {
    margin: 0;
    font-family: var(--g8-font-display);
    font-weight: var(--g8-weight-display);
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1;
    color: var(--g8-open-water);
  }

  .privacy-modal__close {
    flex: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-content: center;
    border-radius: 999px;
    border: var(--g8-stroke) solid var(--g8-border-strong);
    background: transparent;
    color: var(--g8-midnight);
    font-family: var(--g8-font-ui);
    font-size: 15px;
    cursor: pointer;
  }
  .privacy-modal__close:hover {
    background: var(--g8-open-water);
    border-color: var(--g8-open-water);
    color: var(--g8-chalk);
  }

  .privacy-modal__body {
    flex: 1;
    /* The classic flexbox scroll gotcha: without min-height:0, a flex child
       refuses to shrink below its content size, and overflow-y:auto never
       gets the chance to kick in — the panel would just grow past
       max-height instead of scrolling internally. */
    min-height: 0;
    overflow-y: auto;
    padding: 20px clamp(24px, 4vw, 36px) clamp(24px, 4vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .privacy-modal__section-heading {
    margin: 0 0 8px;
    font-family: var(--g8-font-display);
    font-weight: var(--g8-weight-display);
    font-size: 22px;
    line-height: 1.15;
    color: var(--g8-midnight);
  }

  .privacy-modal__section-body {
    margin: 0;
    font-size: var(--g8-size-body);
    line-height: var(--g8-lh-long);
    color: var(--g8-midnight);
  }
  .privacy-modal__section-body a {
    color: var(--g8-ember);
  }
  .privacy-modal__section-body a:hover {
    color: var(--g8-crimson);
  }

  @media (max-width: 680px) {
    .privacy-modal { padding: 0; }
    .privacy-modal__panel {
      width: 100%;
      height: 100%;
      max-height: 100vh;
      border-radius: 0;
      border-width: 0;
      box-shadow: none;
    }
    .privacy-modal__header { padding: 20px 20px 0; }
    .privacy-modal__heading { font-size: 26px; }
    .privacy-modal__body { padding: 16px 20px 32px; }
  }
</style>
