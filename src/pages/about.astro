---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * EDITORIAL PASS — typography now follows the original Keynote (the deck the
 * approved PDF was exported from), verified by extracting the embedded fonts
 * and per-run sizes from design-reference/website-mockup-final.pdf:
 *
 *   JostRoman-Bold       86.3 / 55 / 40.7 / 33px  display + section headings
 *   JostRoman-SemiBold   41 / 28 / 23 / 17px      uppercase category + form labels
 *   Jost-Regular         36.8 / 31 / 26px         body and list copy
 *   Jost-Italic          26px                     emphasis lines
 *   HelveticaNeue-Medium 28px                     every button label
 *   HelveticaNeue        28 / 15px                nav links, small captions
 *
 * So the deck's system is: Jost carries all brand and editorial voice;
 * Helvetica Neue carries interface chrome only. Per instruction Helvetica is
 * replaced with Inter (loaded in BaseLayout). On this page that means Jost
 * everywhere except the two crisis buttons, the founder detail lines, and the
 * proverb attribution — the chrome/metadata register.
 *
 * Sizes are mapped off the deck's 1920px canvas as a proportion of viewport
 * width (86.3/1920 = 4.5%, hence ABOUT's 4.6vw ceiling), which is the same
 * way the homepage maps its own PDF measurements.
 *
 * Also this pass: founder letter loses its card and sits directly on the
 * parchment (the deck sets its own long-form copy — the pledge list — the
 * same way, on the ground with no container); photo re-cropped so Rob is the
 * subject rather than incidental to the landscape; gratitude line loses its
 * decorative rules; the lower slab loses its oversized hard shadow and drops
 * to the medium radius.
 */

/** Keynote's Helvetica Neue → Inter. No global token: only this page uses it. */
const inter = "'Inter', system-ui, -apple-system, sans-serif";
---

<BaseLayout
  title="About — Gr8ful Project"
  description="Gr8ful Project exists to help people live happier lives by making gratitude a bigger part of them."
  homeNav
>
  <div class="g8-container g8-page about-top" style="--pt:64px">
    <div class="about-top__row">
      <h1 class="about-wordmark">ABOUT</h1>
      <div class="about-eyebrow">
        <span>RobbieDob's</span>
        <span>Story</span>
      </div>
    </div>
  </div>

  <!-- Founder — framed photograph left, typography directly on the parchment
       right. No container on the story side: this is a profile spread, not two
       panels, and it also retires the near-but-not-equal height problem. -->
  <section class="g8-container g8-page founder" style="--pt:56px; --pb:0px">
    <div class="g8-grid-2" style="--gap:56px">
      <div class="founder__photo">
        <img
          src="/RobbieDob-about.png"
          alt="RobbieDob giving a peace sign on a mountain trail at sunrise"
        />
      </div>

      <div class="founder__letter">
        <div class="founder__intro">
          <h2 class="founder__headline">Desperate Times<br />Desperate Measures</h2>

          <p class="founder__para robbiedob-note--misregister">
            In 2023, I was crumbling. I didn't know what to do—but I knew if something didn't change,
            I wasn't going to make it. So I did a radical reset, converted a van, and hit the road. Not
            in celebration, but in desperation.
          </p>
          <p class="founder__para robbiedob-note--misregister">
            Getting metaphorically (and sometimes literally) lost changed everything. I found a deep
            gratitude practice—and it saved my life. Proactively managing my mental health grew from
            there.
          </p>
          <p class="founder__para robbiedob-note--misregister">
            The Gr8ful Project will likely be my last chapter as an entrepreneur. But this time, it's
            not about profit. It's about building a lasting community—and helping each other live
            happier. Simple as that.
          </p>
        </div>

        <!-- Sign-off group: pullquote + signature stay together as one
             unit, set apart from the intro copy above by a controlled,
             clamped gap (see .founder__signoff in the CSS) rather than a
             flex push-to-bottom — see that rule's comment for why. -->
        <div class="founder__signoff">
          <p class="founder__pullquote">I'm gr8ful for you, even if we haven't met yet.</p>

          <div class="founder__sign">
            <img src="/join-robbiedob-sig-large.png" alt="RobbieDob's signature" class="founder__sig-img" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gratitude — Bauhaus-inspired divider, width-matched to the lower
       cards below it (not full-bleed any more — see .gratitude__bg-wrap).
       Three separate layers, not one flattened image: the geometric band
       (inline SVG, hand-composed, not runtime-random) inside a
       .g8-container-width wrapper, a cream card sitting on top of it, and
       live quote text on the card. Two SVGs (desktop/mobile) swap by
       breakpoint rather than one viewBox trying to serve both.

       Row rhythm is modeled on design-reference/assets/Bauhaus Quote
       Divider.html — specifically its embedded thumbnail SVG, the only
       real geometry in that file (the rest is bundler/font-loading
       plumbing, not copied). Its palette (blue/pink/green/orange) was
       NOT used — only Gr8ful tokens below. See the "Gratitude divider"
       note in CLAUDE.md for the color-adjacency rule these were composed
       under (verify programmatically after any edit — no two same-fill
       rects may share an edge).

       8 rows on desktop, half the height of the previous 4-row pass
       (50px each, same 400px total) — thinner stripes read as more
       rhythm/less "four giant slabs" without changing the section's own
       height. Any block short enough to look like a fragment sits ONLY
       at x=0 or the row's right canvas edge (never between two other
       blocks) so it reads as "the rest fell off the page" rather than a
       stray nugget; every interior block is medium-to-long.

       SEAM STAGGER — every row's interior block boundaries ("seams") are
       chosen so no seam in any row sits within 84px (desktop, 1440-wide
       canvas) of a seam in any OTHER row — checked pairwise across all 8
       rows, not just neighbors, wood-floor-style, so the eye can't trace
       a vertical line through two or more block breaks. That 84px pool
       (68, 152, 251, 335, 423, 507, 600, 684, 768, 852, 945, 1029, 1122,
       1206, 1291, 1375) was generated once with irregular, hand-adjusted
       gaps (not an even/obvious step), then each row's 1-2 seams were
       drawn from it — so any two rows' seams are guaranteed well apart
       by construction, without the gaps themselves looking like a
       formula. Verified with a throwaway Node script (seam-distance +
       color-adjacency), not shipped — this SVG is still fully
       hand-authored, static markup, no runtime randomness. Re-run that
       same check after any future edit to these rects, the same way the
       color-adjacency rule below already asks you to. -->
  <section class="gratitude">
    <div class="gratitude__bg-wrap g8-container" aria-hidden="true">
      <div class="gratitude__bg">
        <svg
          class="gratitude__svg gratitude__svg--desktop"
          viewBox="0 0 1440 400"
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Row 1 — short edge piece at left, two long bars — seams 152, 684 -->
          <rect x="0" y="0" width="152" height="50" fill="var(--g8-midnight)" />
          <rect x="152" y="0" width="532" height="50" fill="var(--g8-golden-hour)" />
          <rect x="684" y="0" width="756" height="50" fill="var(--g8-deep-teal)" />
          <!-- Row 2 — no edge fragment, 3 medium/long bars — seams 423, 945 -->
          <rect x="0" y="50" width="423" height="50" fill="var(--g8-sea-glass)" />
          <rect x="423" y="50" width="522" height="50" fill="var(--g8-ember)" />
          <rect x="945" y="50" width="495" height="50" fill="var(--g8-open-water)" />
          <!-- Row 3 — two long bars, short edge piece at right (crimson used once, sparingly) — seams 335, 1291 -->
          <rect x="0" y="100" width="335" height="50" fill="var(--g8-midnight)" />
          <rect x="335" y="100" width="956" height="50" fill="var(--g8-mesa)" />
          <rect x="1291" y="100" width="149" height="50" fill="var(--g8-crimson)" />
          <!-- Row 4 — short edge piece at left, two long bars — seams 68, 1029 -->
          <rect x="0" y="150" width="68" height="50" fill="var(--g8-golden-hour)" />
          <rect x="68" y="150" width="961" height="50" fill="var(--g8-sea-glass)" />
          <rect x="1029" y="150" width="411" height="50" fill="var(--g8-deep-teal)" />
          <!-- Row 5 — no edge fragment, 3 medium/long bars — seams 507, 1122 -->
          <rect x="0" y="200" width="507" height="50" fill="var(--g8-ember)" />
          <rect x="507" y="200" width="615" height="50" fill="var(--g8-midnight)" />
          <rect x="1122" y="200" width="318" height="50" fill="var(--g8-open-water)" />
          <!-- Row 6 — two long bars, short edge piece at right — seams 852, 1375 -->
          <rect x="0" y="250" width="852" height="50" fill="var(--g8-open-water)" />
          <rect x="852" y="250" width="523" height="50" fill="var(--g8-sea-glass)" />
          <rect x="1375" y="250" width="65" height="50" fill="var(--g8-mesa)" />
          <!-- Row 7 — short edge piece at left, two long bars — seams 251, 600 -->
          <rect x="0" y="300" width="251" height="50" fill="var(--g8-deep-teal)" />
          <rect x="251" y="300" width="349" height="50" fill="var(--g8-ember)" />
          <rect x="600" y="300" width="840" height="50" fill="var(--g8-golden-hour)" />
          <!-- Row 8 — short edge piece at right (not desktop's usual no-fragment slot
               this pass — needed as a 3rd right-edge row to absorb a seam value
               that had no clean home in a plain 3-medium-block row) — seams 768, 1206.
               First block was sea-glass, which is the EXACT fill of the Planting
               Trees card sitting flush beneath it — the bottom row must not equal
               either lower card's color (sea-glass or deep-teal), so it doesn't
               visually fuse with the card below. Swapped to open-water, which
               still clears every adjacency check: differs from row 7 above at
               every x it overlaps (deep-teal/ember/golden-hour), differs from
               midnight to its right, and isn't used anywhere else in this row. -->
          <rect x="0" y="350" width="768" height="50" fill="var(--g8-open-water)" />
          <rect x="768" y="350" width="438" height="50" fill="var(--g8-midnight)" />
          <rect x="1206" y="350" width="234" height="50" fill="var(--g8-mesa)" />
        </svg>

        <svg
          class="gratitude__svg gratitude__svg--mobile"
          viewBox="0 0 390 280"
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- 6 rows (up from the previous 4) — thinner, related to desktop's
               new rhythm, but not desktop's full 8: at 390px wide, 8 rows
               would squeeze every block back down into the small fragments
               this whole pass is trying to get rid of. Same "short blocks
               only at an outer edge" rule applies.

               Same seam-stagger rule as desktop, scaled down: minimum 30px
               separation between any two rows' seams (not 84px — proportional
               to this canvas being 390px instead of 1440px, not a blind reuse
               of the desktop number), checked all-rows-against-all-rows.
               Seam pool: 35, 69, 111, 147, 187, 220, 259, 294, 335. -->
          <rect x="0" y="0" width="187" height="47" fill="var(--g8-midnight)" />
          <rect x="187" y="0" width="203" height="47" fill="var(--g8-golden-hour)" />
          <rect x="0" y="47" width="35" height="47" fill="var(--g8-sea-glass)" />
          <rect x="35" y="47" width="112" height="47" fill="var(--g8-ember)" />
          <rect x="147" y="47" width="243" height="47" fill="var(--g8-deep-teal)" />
          <rect x="0" y="94" width="259" height="47" fill="var(--g8-golden-hour)" />
          <rect x="259" y="94" width="131" height="47" fill="var(--g8-midnight)" />
          <rect x="0" y="141" width="111" height="47" fill="var(--g8-deep-teal)" />
          <rect x="111" y="141" width="183" height="47" fill="var(--g8-sea-glass)" />
          <rect x="294" y="141" width="96" height="47" fill="var(--g8-ember)" />
          <rect x="0" y="188" width="69" height="46" fill="var(--g8-ember)" />
          <rect x="69" y="188" width="321" height="46" fill="var(--g8-open-water)" />
          <!-- Row 6 (bottom) — same bottom-row/card-color fix as desktop: the
               middle block was deep-teal, the exact fill of the If You're
               Struggling card beneath it. Swapped to midnight, which differs
               from golden-hour (left), mesa (right), and open-water (row 5
               above, at this x-range). -->
          <rect x="0" y="234" width="220" height="46" fill="var(--g8-golden-hour)" />
          <rect x="220" y="234" width="115" height="46" fill="var(--g8-midnight)" />
          <rect x="335" y="234" width="55" height="46" fill="var(--g8-mesa)" />
        </svg>
      </div>
    </div>

    <div class="gratitude__card">
      <p class="gratitude__text">
        <span class="gratitude__mark gratitude__mark--open" aria-hidden="true">&ldquo;</span>
        Gratitude teaches us to<br />
        <span class="gratitude__nowrap"
          >live happier.<span class="gratitude__mark gratitude__mark--close" aria-hidden="true"
            >&rdquo;</span
          ></span
        >
      </p>
      <p class="gratitude__attribution">— RobbieDob</p>
    </div>
  </section>

  <!-- One unified split: deep teal left, sea glass right, clean centre seam.
       Structural border and a restrained radius; no slab shadow. -->
  <section class="g8-container g8-page split" style="--pt:0px">
    <div class="split-panel">
      <div class="g8-grid-2" style="--gap:0px; --align:stretch">
        <div class="struggling-half">
          <h2 class="panel-heading">If You're Struggling</h2>

          <p class="panel-body">I've been there and my heart goes out to you.</p>
          <p class="panel-body">
            The tools we offer — stories, prompts, kindness, community — they're powerful. But
            they're not a replacement for professional care.
          </p>
          <p class="panel-body">
            I am not a therapist or a doctor. I am just a human who's been to the edge and somehow
            made it back.
          </p>
          <p class="panel-body">
            I'd love you to join us, but please, also talk to someone trained to help. Therapy.
            Medication. Crisis lines. Support groups. All of it.
          </p>
          <p class="panel-body">
            Asking for help is one of the most courageous things you can do.
          </p>
          <p class="panel-body">You matter to me, even if we haven't met yet.</p>
          <p class="panel-body">
            Believe me when I say, "Tomorrow can be better than today".
          </p>

          <div class="help">
            <p class="help__label">Need help? Click below.</p>
            <div class="help__links">
              <a
                href="https://www.crisistextline.org"
                class="g8-btn g8-btn--gold g8-btn--sm help__btn"
                style={`font-family:${inter}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Crisis Text Line.org
              </a>
              <a
                href="https://988lifeline.org"
                class="g8-btn g8-btn--gold g8-btn--sm help__btn"
                style={`font-family:${inter}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                988 Lifeline.org
              </a>
            </div>
          </div>
        </div>

        <div class="planting-half">
          <h2 class="panel-heading">Planting Trees</h2>

          <p class="panel-body">
            I remember being in 4th grade and waking up to my alarm clock at 6:45 am. I recall
            brushing my teeth, getting dressed, and walking into the dark kitchen and turning on the
            lights. I'd pour myself a bowl of cereal and pack my lunch for the day.
          </p>
          <p class="panel-body">
            My mom was asleep when I left for school and she was in bed when I got home. I don't
            remember when I realized she was struggling with depression and anxiety, but I can't
            recall a time when she wasn't. And although sleeping in was not her at her best, it
            certainly wasn't her at her worst either.
          </p>
          <p class="panel-body">
            Life moved on, and I thought I'd overcome my childhood. Truth is, I was so used to living
            in a heightened state I couldn't see how much anxiety and trauma I was carrying with me.
            I hadn't really overcome anything—I had merely escaped. I was a classic high-performing
            kid from a traumatic home.
          </p>

          <blockquote class="proverb">
            <p class="proverb__text">
              "The Best Time to Plant a Tree is 30 Years Ago. The Second Best Time is Today"
            </p>
          </blockquote>

          <p class="panel-body">
            I wish 20 year old me knew what 50 year old me knows, but I'm proud I'm still planting
            trees and working to be the best and happiest version of myself.
          </p>
          <p class="panel-body planting__closing">
            Here's to new beginnings and planting some trees together.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Intro ────────────────────────────────────────────
     Deck's largest display run is JostRoman-Bold at 86.3px on a 1920 canvas
     = 4.5% of canvas width, so the ceiling here is 4.6vw rather than the 92px
     it was carrying (6.4vw at 1440 — visibly oversized against the rest of
     the page). Tracking stays tight: the deck's Jost Bold display is set
     tight, not letterspaced. Golden Hour + hard offset matches the deck's
     own treatment of that title. */
  .about-top { padding-bottom: 0; }

  /* Desktop: ABOUT on the content grid's left edge, the eyebrow pinned to
     its right edge (matching the founder grid/split panel below) and
     bottom-aligned so it pairs with the lower half of the wordmark rather
     than floating at an arbitrary height. Stacks back to the original
     left-aligned column on narrow screens, where a two-ended row would
     just get cramped. */
  .about-top__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .about-wordmark {
    margin: 0;
    font-family: var(--g8-font-ui);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
    font-size: clamp(40px, 4.6vw, 72px);
    line-height: 1;
    color: var(--g8-golden-hour);
    text-shadow: 3px 3px 0 var(--g8-midnight);
  }

  /* Same JostRoman-SemiBold 41pt register as the homepage's right-side
     descriptors (LIFE/GRATITUDE, MUSIC/COMMUNITY, SELFLESS/SERVICE) — and
     now the SAME two-line stacked treatment too (a flex column of two
     spans, right-aligned), not a single nowrap line — so this genuinely
     reads as that same recurring element rather than a look-alike. */
  .about-eyebrow {
    margin: 0;
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    font-family: var(--g8-font-ui);
    font-weight: 600;
    font-size: var(--g8-descriptor-size);
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--g8-open-water);
  }

  /* ── Founder ──────────────────────────────────────────
     Photo keeps the site's established framed-photo treatment; the letter has
     no container at all. */
  .founder__photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--g8-radius-lg);
    border: var(--g8-stroke) solid var(--g8-border-strong);
  }
  .founder__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Art-directed, not centred. The source is a tall 690×1194 frame with Rob
       in its lower third; at 4:5 the window shows ~72% of that height, and
       50% 70% lands it on image rows ~19–92%: sun cresting the ridge at the
       top edge, full mountain, Rob large enough to read as the subject with
       the peace sign clear. (The previous 22% put his eyeline ~74% down the
       crop, which read as a landscape that happened to contain a person.)
       The ratio is identical at every breakpoint, so mobile gets the same
       art direction rather than a separate, worse crop. */
    object-position: 50% 70%;
  }

  /* PREVIOUSLY: a flex column stretched to the photo's own height, with
     justify-content:space-between pushing the sign-off group down to meet
     the photo's bottom edge. That broke at large desktop widths: this
     grid's columns only grow up to .g8-container's own 1240px cap, but
     they DO grow between ~900px and that cap, and paragraph line length
     growing with them shortened the body copy (fewer, longer-wrapped
     lines) — as the text got shorter, space-between had more empty height
     to distribute above the sign-off, producing a large, growing dead gap
     right before the orange note instead of the intended tight rhythm.
     (Beyond the container's own cap the layout was already frozen either
     way, so the gap didn't keep growing past ~1440px, but it was already
     bad there.)

     Fixed at the cause, not with a patch: cap the actual reading measure
     (max-width below) so line length — and therefore paragraph height —
     stays essentially constant across the whole desktop range instead of
     shrinking as the column widens. With the text block's height no longer
     shrinking, a small fixed/clamped gap (see .founder__signoff) is enough
     on its own; the height-matching push is no longer needed. */
  .founder__letter {
    padding-top: 4px;
    /* Narrowed from 620px (~6.5%) purely for vertical balance against the
       photo — a slightly tighter measure wraps each paragraph onto a bit
       more height without reading as a cramped column. Still well within
       a comfortable reading width. */
    max-width: 580px;
  }

  /* Deck's heading register is Jost Bold in sentence case — the uppercase
     runs in the deck are the SemiBold category tags, not headings. Two
     centered lines (structure only, borrowed from an old-site reference —
     not its font, color, or panel treatment, all of which stay this site's
     own) rather than the previous single "A / B" line — the slash is gone,
     replaced by the line break in the markup. Tight line-height (vs. body
     copy's much more open 1.73) is what makes two lines read as one
     compact title instead of two loosely related headlines. */
  .founder__headline {
    margin: 0 0 22px;
    text-align: center;
    font-family: var(--g8-font-ui);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.005em;
    color: var(--g8-midnight);
  }

  /* Jost-Regular 26px on the 1920 canvas ≈ 19px here; 18px with open leading
     reads comfortably at this 556px measure (~62 characters). Gap raised
     20px→30px — the other half of the vertical-balance adjustment
     alongside the narrower max-width above; one consistent value, not a
     per-paragraph tune. */
  .founder__para {
    margin: 0 0 30px;
    font-family: var(--g8-font-ui);
    font-weight: 400;
    font-size: 18px;
    /* +4.85% over the previous 1.65 — a little more air next to the
       spacious photo opposite it, without loosening into a different
       register. Font size/weight/color/measure/paragraph spacing all
       untouched. */
    line-height: 1.73;
    color: var(--g8-midnight);
  }

  /* EXPERIMENT — Experimental print-misregistration treatment. Two hard,
     zero-blur, low-opacity text-shadows (Mesa warm + Open Water cool),
     offset a fraction of a pixel in opposite directions, sitting behind
     the real (still fully opaque, still var(--g8-midnight)) text — meant
     to read as a faint handmade/analog-print texture, not a colored
     shadow effect. Scoped to RobbieDob's note body copy only. (A sentence-
     level "irregular variant" version of this was tried and reverted —
     it read as inconsistent/like a mistake rather than intentional, so
     back to one uniform value for the whole note.) To revert the whole
     experiment: delete this rule and its @media block below, and remove
     the `robbiedob-note--misregister` class from the three .founder__para
     elements in the markup above. */
  .robbiedob-note--misregister {
    text-shadow:
      0.7px 0.55px 0 rgba(201, 105, 40, 0.38),
      -0.6px -0.45px 0 rgba(7, 147, 150, 0.32);
  }
  @media (max-width: 680px) {
    /* Fine sub-pixel offsets get fuzzier on small/high-density screens —
       eased down rather than left at the desktop strength. */
    .robbiedob-note--misregister {
      text-shadow:
        0.5px 0.4px 0 rgba(201, 105, 40, 0.23),
        -0.45px -0.35px 0 rgba(7, 147, 150, 0.19);
    }
  }

  /* Sign-off group (orange note + signature): the orange line is the
     story's closing thought, not a separate footer, so it gets the SAME
     gap above it as any other paragraph transition — matching
     .founder__para's own 30px margin-bottom exactly (these collapse at the
     .founder__intro/.founder__signoff boundary, so 30px here reproduces
     the identical rhythm rather than adding to it). No forced push toward
     the photo's bottom edge — the max-width readable-width fix
     (.founder__letter, above) is what keeps the large-desktop gap under
     control; this value doesn't do that job. */
  .founder__signoff {
    margin-top: 30px;
  }

  /* Deck sets its emphasis lines in Jost-Italic at body size. */
  .founder__pullquote {
    margin: 0;
    font-family: var(--g8-font-ui);
    font-style: italic;
