---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinProjectSection from '../components/JoinProjectSection.astro';
import JamCard from '../components/JamCard.astro';
import { jamCards } from '../data/jams';
---

<BaseLayout
  title="Gr8ful Project"
  description="A podcast and a string of good excuses to get together — live tapings, rooftop shows, and a lot of peanut butter and jelly."
  transparentHeader
>
  <section class="hero" id="top">
    <!--
      B&W community video. A light grayscale filter plus a bottom-weighted
      scrim hold type contrast without crushing the footage toward black —
      see .hero__plate / .hero__scrim below. Decorative, so it's hidden from
      assistive tech; the script below pauses it when the visitor prefers
      reduced motion.
    -->
    <video
      class="hero__plate"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/hero-poster-2.jpg"
      aria-hidden="true"
      tabindex="-1"
      data-hero-video
    >
      {/* Portrait plate on narrow viewports, landscape everywhere else. */}
      <source src="/hero-bw-portrait.mp4" type="video/mp4" media="(max-width: 767px)" />
      <source src="/hero-bw-landscape.mp4" type="video/mp4" />
    </video>
    <div class="hero__scrim"></div>
    {/*
      Vignette — separate from .hero__scrim above so the already-tuned
      overall brightness/scrim balance isn't touched. Purely edge and
      corner darkening: perimeter and top (nav legibility) and lower-left
      (hero copy legibility), leaving the center of the frame the
      brightest part of the video.
    */}
    <div class="hero__vignette" aria-hidden="true"></div>

    <div class="g8-container hero__body">
      <h1 class="hero__headline">
        <img src="/hero-live-happier.png" alt="Live Happier" class="hero__headline-img" />
      </h1>
      <p class="hero__tagline">
        Podcast <span class="hero__plus">+</span> Music <span class="hero__plus">+</span> Community
      </p>
      <div class="hero__actions">
        <a href="#join" class="g8-btn g8-btn--gold g8-btn--cta g8-btn--cta-shadow">Join the Project →</a>
      </div>
    </div>
  </section>

  <!--
    Podcast teaser — page 2 of the approved redesign. Full-bleed section (own
    parchment wallpaper + full-width stripe ribbon), with text and the media
    card constrained to the standard .g8-container so it lines up with every
    other section on the page.
  -->
  <section class="podcast-teaser g8-section-panel" id="podcast">
    <img
      src="/podcast-wallpaper-parchment.jpg"
      alt=""
      aria-hidden="true"
      class="podcast-teaser__bg"
    />

    <div class="g8-container podcast-teaser__head">
      <div class="podcast-teaser__title">
        <img src="/podcast-wordmark.png" alt="Podcast" class="podcast-teaser__wordmark" />
        <p class="podcast-teaser__byline">
          with <img src="/robbiedob-sig.png" alt="Robbie Dob" class="podcast-teaser__sig" />
        </p>
      </div>
      <div class="podcast-teaser__tags">
        <span>Life</span>
        <span>Gratitude</span>
      </div>
    </div>

    <div class="podcast-teaser__media-wrap">
      <img
        src="/podcast-wallpaper-stripes-original.png"
        alt=""
        aria-hidden="true"
        class="podcast-teaser__ribbon"
      />
      <div class="g8-container">
        <div class="podcast-teaser__card" data-podcast-card>
          {/*
            TEMPORARY PROTOTYPE MEDIA — cropped straight from page 2 of the
            approved PDF mockup, not a final production asset. Replace with
            a real episode photo/video once one exists. The play mark that
            used to be baked into this crop is now a real coded button
            (below) instead — clicking it swaps this image for a live
            YouTube embed of the Gr8ful Podcast playlist, in this exact
            card. See the script at the bottom of this file.
          */}
          <img
            src="/podcast-still-prototype.jpg"
            alt="Podcast episode preview — placeholder image, not final"
            class="podcast-teaser__media"
            data-podcast-poster
          />
          <button
            type="button"
            class="podcast-teaser__play"
            data-podcast-play
            aria-label="Play the latest Gr8ful Podcast episode"
          >
            <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
              <path d="M8 5v14l11-7z" fill="var(--g8-midnight)" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="podcast-teaser__cta-wrap">
      <a href="https://www.youtube.com/playlist?list=PLJ06EoI7HZ1c" target="_blank" rel="noopener noreferrer" class="g8-btn g8-btn--cta g8-btn--cta-shadow podcast-teaser__cta">See all episodes →</a>
    </div>
  </section>

  <!--
    Jams teaser — page 3 of the approved redesign. Same full-bleed-section /
    13%-inset-content pattern as the Podcast teaser above, with its own
    sea-glass gradient background.
  -->
  <section class="jams-teaser g8-section-panel" id="jams">
    <img
      src="/jams-wallpaper-seaglass-original.png"
      alt=""
      aria-hidden="true"
      class="jams-teaser__bg"
    />
    {/*
      Sampling the actual PDF (not just the standalone asset) shows the top
      of the section is measurably warmer/lighter than the raw PNG alone —
      e.g. rgb(247,242,223) in the PDF vs. rgb(220,240,231) at the same
      point in the source file — while the bottom two-thirds match the raw
      asset almost exactly. So the approved composition layers a warm
      cream fade over the real asset, blending it into the Podcast
      section's cream above; the asset by itself doesn't produce that. This
      reproduces that fade as a separate layer rather than replacing the
      real asset with an invented gradient.
    */}
    <div class="jams-teaser__fade" aria-hidden="true"></div>

    <div class="jams-teaser__head">
      <img src="/jams-wordmark.png" alt="Jams" class="jams-teaser__wordmark" />
      <div class="jams-teaser__tags">
        <span>Music</span>
        <span>Community</span>
      </div>
    </div>

    {/*
      Card content/state lives in src/data/jams.ts; the card markup itself
      is src/components/JamCard.astro (published vs. coming-soon — see the
      "Jams cards" note in CLAUDE.md). All four still reuse the same
      TEMPORARY PROTOTYPE MEDIA cropped from page 3 of the approved PDF —
      the PDF itself repeats one placeholder performer pair (Andy Babb +
      Lara Elle) across all four cards, which this reproduces deliberately,
      not a live data source yet. Cards after the first are marked
      `decorative` so the duplicate placeholder photos don't get announced
      four times over.
    */}
    <div class="jams-teaser__row">
      {jamCards.map((card, i) => (
        <JamCard {...card} decorative={i > 0} />
      ))}
    </div>

    <div class="jams-teaser__cta-wrap">
      <a href="https://www.youtube.com/playlist?list=PLJNrF11lrZ3g" target="_blank" rel="noopener noreferrer" class="g8-btn g8-btn--cta g8-btn--cta-shadow jams-teaser__cta">See all JAMS →</a>
    </div>
  </section>

  <!--
    Seva teaser — page 4 of the approved redesign. Full-bleed color photo
    (the only full-color section on the homepage; everything else is B&W or
    flat brand color), with the same 13%-inset head-row pattern as Podcast
    and Jams above it. Stats are static for this prototype — not wired to
    Luma or computed, per instruction.
  -->
  <section class="seva-teaser g8-section-panel" id="seva">
    <img src="/seva-background-photo.jpg" alt="" class="seva-teaser__bg" />
    {/*
      Localized top and bottom darkening, same spirit as the hero vignette:
      measured off the PDF directly (luminance ~0-6 at the top and bottom
      edges, but 200+ at mid-height on both sides), this is a top band and
      a bottom band fading toward an open, undarkened middle — not a
      uniform dim over the whole photo.
    */}
    <div class="seva-teaser__vignette" aria-hidden="true"></div>

    <div class="seva-teaser__head">
      <img src="/seva-wordmark.png" alt="Seva" class="seva-teaser__wordmark" />
      <div class="seva-teaser__tags">
        <span>Selfless</span>
        <span>Service</span>
      </div>
    </div>

    <p class="seva-teaser__definition">
      <em><u>Seva</u>: (V)</em> To serve. Work performed without expectation of reward, repayment
      or personal gain.
    </p>

    {/*
      Static for this prototype — not wired to Luma or computed.
      Numbers start at 0 in the markup and count up via the script below
      once the card scrolls into view (see data-count-to); a no-JS visitor
      sees 0 rather than the real totals, a deliberate trade-off for the
      count-up per instruction — this card is supplementary, not a
      critical path like the pledge form's no-JS fallback.
    */}
    <div class="seva-teaser__stats" data-stats-card>
      <div class="seva-teaser__stat-row">
        <div class="seva-teaser__stat">
          <span class="seva-teaser__stat-num seva-teaser__stat-num--teal" data-count-to="16">0</span>
          <span class="seva-teaser__stat-label seva-teaser__stat-label--teal">Events</span>
        </div>
        <div class="seva-teaser__stat">
          <span class="seva-teaser__stat-num seva-teaser__stat-num--rust" data-count-to="652">0</span>
          <span class="seva-teaser__stat-label seva-teaser__stat-label--rust">Lunches Served</span>
        </div>
      </div>
      <span class="seva-teaser__stat-caption">As of August 25, 2026</span>
    </div>
  </section>

  <JoinProjectSection />
</BaseLayout>

<script>
  // Autoplay is decorative, so honour a reduced-motion preference — CSS alone
  // can't pause a video. Tracks the setting live, not just on load.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const applyMotionPreference = () => {
    if (!video) return;
    if (reduceMotion.matches) {
      video.pause();
    } else {
      // Rejects when a browser blocks autoplay; the scrim reads fine either way.
      video.play().catch(() => {});
    }
  };

  applyMotionPreference();
  reduceMotion.addEventListener('change', applyMotionPreference);
</script>

<script>
  // Seva stats count-up. Replays every time the card meaningfully enters
  // the viewport (not just the first time) — scroll away and back and it
  // counts up again from zero. Reduced-motion visitors get the final
  // numbers immediately instead of a count, and never touch the observer
  // below at all. No external dependency — plain IntersectionObserver +
  // requestAnimationFrame.
  const statsCard = document.querySelector<HTMLElement>('[data-stats-card]');
  const numberEls = statsCard?.querySelectorAll<HTMLElement>('[data-count-to]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const setFinal = () => {
    numberEls?.forEach((el) => {
      el.textContent = el.dataset.countTo ?? el.textContent;
    });
  };

  if (!statsCard || !numberEls || numberEls.length === 0) {
    // no-op — section not present on this page render
  } else if (prefersReducedMotion) {
    setFinal();
  } else {
    const DURATION_MS = 1200;
    // Cubic ease-out — fast start, settles gently into the final number
    // rather than ticking at a constant rate to the end.
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

    // Bumped on every run/reset so an in-flight animation can tell it's
    // been superseded. Without this, scrolling away mid-count and back
    // again would leave the OLD requestAnimationFrame loop still writing
    // numbers alongside the new one — two animations racing over the same
    // element. Each tick checks its own captured id against the current
    // one and just stops (no further rAF scheduled) the moment it's stale;
    // nothing to explicitly cancel.
    let runId = 0;

    const runCountUp = () => {
      const myRunId = ++runId;
      const start = performance.now();
      const targets = Array.from(numberEls).map((el) => ({
        el,
        to: parseInt(el.dataset.countTo ?? '0', 10),
      }));

      const tick = (now: number) => {
        if (myRunId !== runId) return; // superseded by a reset or a newer run
        const elapsed = now - start;
        const progress = Math.min(elapsed / DURATION_MS, 1);
        const eased = easeOutCubic(progress);
        targets.forEach(({ el, to }) => {
          el.textContent = String(Math.round(to * eased));
        });
        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          // Guarantees an exact final value regardless of any rounding
          // drift in the last animated frame.
          setFinal();
        }
      };

      requestAnimationFrame(tick);
    };

    // Whether this visibility session has already played its count-up —
    // reset to false on every exit, so re-entry knows to run again. This
    // (not observer.disconnect()) is what makes the replay possible: one
    // observer for the page's whole life, just tracking enter/exit state
    // instead of tearing itself down after the first hit.
    let hasEnteredThisVisit = false;

    const armForNextEntry = () => {
      hasEnteredThisVisit = false;
      runId++; // invalidate any animation still in flight
      // Safe to snap to 0 here without a visible flash — this only runs
      // when the card is NOT meaningfully visible (isIntersecting: false
      // at the same 0.4 threshold used to trigger the count-up).
      numberEls?.forEach((el) => {
        el.textContent = '0';
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (!hasEnteredThisVisit) {
              hasEnteredThisVisit = true;
              runCountUp();
            }
          } else {
            armForNextEntry();
          }
        }
      },
      { threshold: 0.4 }
    );
    observer.observe(statsCard);
  }
</script>

<script>
  // Podcast card: clicking Play swaps the poster image for a live YouTube
  // embed of the Gr8ful Podcast playlist, in place, inside the same card —
  // no new tab, no modal, no second video box. autoplay=1 is safe here
  // specifically because it only ever runs from this click handler (a real
  // user gesture), never on page load.
  const podcastCard = document.querySelector<HTMLElement>('[data-podcast-card]');
  const playBtn = document.querySelector<HTMLButtonElement>('[data-podcast-play]');
  const poster = document.querySelector<HTMLImageElement>('[data-podcast-poster]');

  playBtn?.addEventListener('click', () => {
    if (!podcastCard) return;
    const iframe = document.createElement('iframe');
    // Inline styles, not the .podcast-teaser__frame class declared below —
    // Astro's scoped CSS only decorates elements present in this file's
    // own static template at build time; an element created here via
    // document.createElement never gets that scope attribute, so the
    // class rule would silently never match (confirmed: iframe rendered at
    // the browser's ~304×154 default instead of filling the card). Inline
    // styles sidestep that entirely.
    // border-radius:inherit — the card's own overflow:hidden clips the
    // iframe to its rounded corners in most cases, but iframes are
    // replaced elements that don't always respect an ancestor's radius
    // clip reliably across browsers/compositing paths. Setting the radius
    // directly (inherited from the card, not a separate hard-coded value)
    // guarantees the same silhouette regardless.
    //
    // Sized by aspect-ratio, not inset:0/height:100% — the card itself is
    // 1234:679 (≈1.817:1, the PDF-measured shape), noticeably wider than
    // the video's true 16:9 (≈1.778:1). Filling the card exactly as before
    // handed YouTube's OWN player a non-16:9 box, which it then pillarboxed
    // internally (thin black bars, left/right) rather than stretch. Fixing
    // the iframe itself to 16/9 at full card WIDTH removes that internal
    // pillarboxing entirely; the ~2% height surplus that creates versus the
    // card's own shorter height is absorbed by the card's existing
    // overflow:hidden (already relied on for the rounded corners), split
    // evenly top/bottom by the vertical centering below — a couple of
    // pixels, nowhere near the control bar, not a left/right crop.
    iframe.style.cssText =
      'position:absolute; left:0; top:50%; width:100%; aspect-ratio:16/9; transform:translateY(-50%); border:0; display:block; border-radius:inherit;';
    // videoseries + a playlist id: YouTube's own "play this playlist"
    // embed, so it plays whatever is first in the Gr8ful Podcast playlist
    // rather than one hard-coded video id — see the note in CLAUDE.md on
    // what that does and doesn't guarantee about "newest episode first".
    iframe.src =
      'https://www.youtube-nocookie.com/embed/videoseries?list=PLJ06EoI7HZ1c&autoplay=1&rel=0&playsinline=1';
    iframe.title = 'Gr8ful Podcast — latest episode';
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    poster?.remove();
    playBtn.remove();
    podcastCard.appendChild(iframe);
  });
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────
     B&W footage under Golden Hour type. The scrim is what holds 4.5:1 over
     moving footage — nothing behind type may exceed --g8-hero-max-luma. */
  .hero {
    position: relative;
    margin: 0;
    border-radius: 0;
    /* height, not min-height — matches .g8-section-panel (global.css) so
       Hero measures IDENTICALLY to Podcast/Jams/Seva/Join, not just
       "at least" the same. 100vh first as the fallback for browsers
       without svh support; 100svh (small viewport height) sizes to what's
       guaranteed visible on real mobile browsers, where 100vh is the
       *largest* possible viewport (before the address bar collapses) and
       would otherwise leave a gap at an edge. */
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--g8-midnight);
    overflow: hidden;
  }

  .hero__plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Lighter than the shared --g8-hero-filter token: the approved design
       keeps the footage's own tonal range legible, not flattened toward
       black. Scoped here rather than changing the token, which nothing
       else on the site reads. */
    filter: grayscale(1) contrast(1.05) brightness(0.92);
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(1, 7, 21, 0.12) 0%, rgba(1, 7, 21, 0.5) 100%);
  }

  .hero__vignette {
    /* Five stacked layers, edges/corners only — the center stays exactly
       as bright as .hero__scrim already leaves it. Measured directly off
       the PDF: corner/edge luminance sits near-black (0-14 out of 255)
       while the open center reaches well over 100, so the previous single-
       digit-percent layers read as "too subtle" — this pass pushes peak
       edge opacity much higher and, critically, lets the top band and the
       left/right edge bands overlap at the top corners so those corners
       come out darker than either band alone (matching "especially dark"
       upper corners) without a fully separate corner-specific gradient. */
    position: absolute;
    inset: 0;
    background:
      /* extra patch behind the hero copy's lower-left corner */
      radial-gradient(ellipse 62% 52% at 12% 92%, rgba(1, 7, 21, 0.62) 0%, rgba(1, 7, 21, 0) 62%),
      /* band behind the nav — reaches further down than before, and darker */
      linear-gradient(180deg, rgba(1, 7, 21, 0.72) 0%, rgba(1, 7, 21, 0.22) 15%, rgba(1, 7, 21, 0) 27%),
      /* left edge falloff */
      linear-gradient(90deg, rgba(1, 7, 21, 0.6) 0%, rgba(1, 7, 21, 0) 24%),
      /* right edge falloff */
      linear-gradient(270deg, rgba(1, 7, 21, 0.6) 0%, rgba(1, 7, 21, 0) 24%),
      /* overall perimeter vignette, transparent through the open center */
      radial-gradient(ellipse 68% 68% at 50% 46%, rgba(1, 7, 21, 0) 38%, rgba(1, 7, 21, 0.55) 100%);
  }

  .hero__body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Full-bleed, not the capped .g8-container — see the matching comment
       on .header--overlay .header__bar in SiteHeader.astro. Both now read
       the SAME shared token (tokens.css), so the logo and every hero
       element lock to one left-hand guide by construction, not by two
       files coincidentally repeating an identical literal value. */
    max-width: none;
    margin-inline: 0;
    --g8-page-gutter: var(--g8-hero-inset);
    padding-block: 64px 88px;
  }

  .hero__headline {
    margin: 0 0 clamp(4px, 0.3vw, 8px);
  }

  .hero__headline-img {
    /* Keynote's Live Happier art measures 34.7% of the 1920 canvas (666px)
       — the previous 385px cap was rendering it at little over half that
       intended size. Fluid up to the reference size, floored for phones. */
    display: block;
    width: clamp(220px, 34.7vw, 666px);
    height: auto;
  }

  .hero__tagline {
    /* Jost-Regular 36.8pt in the Keynote, not the Poppins body face this
       carried before. Pulled back a step from the prior pass: at 100%/
       Actual Size zoom the line ran past the "e" in "Happier" above it,
       toward the final "r" — sized here so "Community"'s final "y" lands
       under that "e" instead, matched by pixel-column ink analysis of the
       Live Happier artwork, not by comparing PNG bounding-box percentages. */
    margin: 0 0 clamp(20px, 2vw, 40px);
    font-family: var(--g8-font-ui);
    font-weight: 400;
    font-size: clamp(18px, 2.29vw, 37px);
    line-height: 1.3;
    color: var(--g8-chalk);
  }

  .hero__plus {
    color: var(--g8-open-water);
    font-weight: var(--g8-weight-strong);
    padding-inline: 2px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
  }

  /* ── Podcast teaser ───────────────────────────────── */
  /* Nav-anchor landing spots. Neither header variant is fixed/sticky (the
     overlay one is position:absolute and scrolls away with the hero), so
     nothing actually overlaps an anchored section — this is just a little
     breathing room above the landing point rather than a hard requirement. */
  #podcast, #jams, #seva, #join {
    scroll-margin-top: 16px;
  }

  .podcast-teaser {
    /* Padding trimmed from 112/128 — with the section now a true 100svh
       (not min-height), this content has to actually fit inside it rather
       than grow the section past its neighbors. The flex centering on
       .g8-section-panel absorbs whatever's left over, so this doesn't need
       to sum to exactly the viewport height, just comfortably under it. */
    position: relative;
    overflow: hidden;
    padding-block: 64px;
  }

  .podcast-teaser__bg {
    /* No z-index, same as .hero__plate — it's the first element in the
       section, so normal paint order already puts every later sibling on
       top of it without needing to escape the stacking context. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .podcast-teaser__head {
    /* position:relative (z-index:auto) puts this in the same paint bucket
       as .podcast-teaser__bg, which is also positioned — without it, this
       plain in-flow div paints BEHIND the positioned background image
       regardless of DOM order, a classic stacking-context gotcha. Same
       reason .hero__body carries position:relative. */
    position: relative;
    /* Full-bleed, not the capped .g8-container — measured off the PDF, the
       wordmark sits at 13.1% of the canvas width from the left and the
       LIFE/GRATITUDE tags at 12.9% from the right. Same fix as the hero's
       logo/headline inset: 100% of .g8-container tracks its 1240px
       max-width, which at ordinary laptop widths reads as far less than
       13% of the viewport. Scoped to this row only — the media card,
       ribbon, and CTA below keep the standard container. */
    max-width: none;
    margin-inline: 0;
    padding-inline: var(--g8-hero-inset);
    display: flex;
    /* nowrap by default — this row must stay side-by-side (title left, tags
       right) at every desktop/tablet width. Only the narrow-mobile media
       query below switches it to a stacked column. */
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 28px;
  }

  .podcast-teaser__title {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .podcast-teaser__wordmark {
    display: block;
    width: min(100%, 380px);
    height: auto;
    /* The supplied PODCAST.png is flat orange with no baked-in shadow
       (confirmed by inspecting the source file directly) — the PDF's hard,
       zero-blur dark offset is reproduced here. drop-shadow (not
       box-shadow) follows the letterforms' alpha shape rather than
       drawing a shadow behind the image's whole rectangular bounds. */
    filter: drop-shadow(3px 3px 0 var(--g8-midnight));
  }

  .podcast-teaser__byline {
