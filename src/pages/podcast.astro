---
import BaseLayout from '../layouts/BaseLayout.astro';
import { latestEpisodeUrl, podcastPlatforms } from '../data/site';
---

<BaseLayout
  title="The Gr8ful Podcast — Gr8ful Project"
  description="Conversations with musicians about gratitude, taped live in front of a room of people at a Gr8ful Jam."
>
  <div class="g8-container g8-page">
    <div class="g8-grid-2" style="--col-a:1.15fr; --col-b:1fr; --gap:56px">
      <div>
        <div class="g8-eyebrow show__label">The show</div>
        <h1 class="g8-display show__headline">The Gr8ful Podcast</h1>
        <p class="g8-lede show__lede">
          Conversations with musicians about gratitude — where it lives in their music, what it
          looks like on a bad day, and what happens when you say it out loud. Each episode weaves
          the interview together with the artist's live performance, taped in front of a room of
          people at a Gr8ful Jam.
        </p>
        <a href={latestEpisodeUrl} class="g8-btn g8-btn--gold g8-btn--bordered">
          Watch the latest episode
        </a>
      </div>

      <div class="g8-stack">
        <div class="g8-card panel">
          <div class="g8-label panel__label">Listen wherever you do</div>
          <div class="panel__chips">
            {
              podcastPlatforms.map((platform) => (
                <a href={platform.href} class="g8-btn g8-btn--chip g8-btn--xs">
                  {platform.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="g8-card g8-card--teal panel">
          <div class="g8-serif panel__pitch" style="--fs:30px; --lh:1.1">
            Want to be in the room?
          </div>
          <a href="/jams" class="g8-btn g8-btn--gold g8-btn--sm">Come to a jam</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .show__label { display: block; margin-bottom: 16px; }
  .show__headline { margin-bottom: 20px; }
  .show__lede { margin-bottom: 32px; }

  .panel { padding: 32px; }
  .panel__label { display: block; margin-bottom: 18px; }

  .panel__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .panel__pitch {
    color: var(--g8-chalk);
    margin-bottom: 14px;
  }

  @media (max-width: 680px) {
    .panel { padding: 26px 24px; }
  }
</style>
