---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Van — Gr8ful Project"
  description="You may have seen the van. It gets around, and it has stories."
>
  <!-- Midnight ground: no paper grain under darkness. -->
  <div class="g8-band-dark">
    <div
      class="g8-container g8-page g8-grid-2"
      style="--pt:88px; --pb:88px; --col-a:1.05fr; --col-b:1fr; --gap:56px; --align:center"
    >
      <div>
        <div class="g8-eyebrow g8-eyebrow--cool hero__label">Lore</div>
        <h1 class="g8-display hero__headline" style="--fs:76px">The Van</h1>
        <p class="g8-lede g8-lede--invert hero__lede">
          Legend has it the van was won in a harmonica duel outside Taos in 1974, crossed the
          Continental Divide on three cylinders and pure gratitude, and once idled outside a
          concert long enough that the bass line soaked permanently into its panels.
        </p>
        <p class="g8-lede g8-lede--cool">
          None of that is true. The real story is coming — and honestly, it's better.
        </p>
      </div>

      <div class="g8-placeholder g8-placeholder--dark hero__photo">
        <span class="g8-caption">Photo · the van, in the wild</span>
      </div>
    </div>
  </div>

  <div class="g8-container g8-page g8-grid-2" style="--pt:80px; --pb:96px; --gap:32px">
    <!-- Scan-the-QR landing panel: the van sends people straight here. -->
    <div class="g8-card g8-card--parchment g8-card--shadow panel">
      <div class="g8-serif panel__headline" style="--fs:38px; --lh:1.08">
        If you scanned the code on the side: hi. You found us.
      </div>
      <p class="panel__body">Take the pledge while you're here.</p>
      <a href="/pledge" class="g8-btn g8-btn--primary">Take the Pledge</a>
    </div>

    <div class="panel panel--pending">
      <div class="g8-eyebrow panel__label">Coming soon</div>
      <div class="g8-serif panel__headline" style="--fs:38px; --lh:1.08">Guest Book</div>
      <p class="panel__body panel__body--last">You'll be able to sign it right here.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .hero__label { display: block; margin-bottom: 16px; }
  .hero__headline {
    color: var(--g8-golden-hour);
    margin-bottom: 22px;
  }
  .hero__lede { margin-bottom: 16px; }
  .hero__photo { height: 400px; }

  .panel { padding: 44px 40px; }
  .panel--pending {
    background: var(--g8-surface);
    border: var(--g8-stroke) dashed rgba(1, 7, 21, 0.35);
    border-radius: var(--g8-radius-lg);
  }

  .panel__label { display: block; margin-bottom: 14px; }
  .panel__headline { margin-bottom: 14px; }

  .panel__body {
    margin: 0 0 26px;
    font-size: 17px;
    line-height: var(--g8-lh-body);
    color: var(--g8-text-muted);
  }
  .panel__body--last { margin-bottom: 0; }

  @media (max-width: 900px) {
    .hero__photo { height: 320px; }
  }

  @media (max-width: 680px) {
    .hero__photo { height: 240px; }
    .panel { padding: 32px 26px; }
    .panel--pending { border-radius: var(--g8-radius-md); }
  }
</style>
